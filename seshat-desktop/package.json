{
  "name": "seshat-desktop",
  "version": "0.1.0",
  "description": "SeshatOS Desktop Client",
  "main": "out/main/index.js",
  "private": true,
  "author": {
    "name": "KPO-Tech",
    "email": "projectsengineer6@gmail.com"
  },
  "homepage": "https://github.com/KPO-Tech/seshat-ai",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node scripts/start-desktop-dev.mjs",
    "dev": "node scripts/start-desktop-dev.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint src",
    "build:backend:win": "node ../scripts/build-desktop-sidecar.mjs windows amd64",
    "build:backend:linux": "node ../scripts/build-desktop-sidecar.mjs linux amd64",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build:backend:win && npm run build && electron-builder --win nsis",
    "package:linux": "npm run build:backend:linux && npm run build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.5.0",
    "electron-updater": "^6.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "build": {
    "appId": "com.seshat.os",
    "productName": "SeshatOS",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "build/install-docling.ps1",
        "to": "install-docling.ps1"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KPO-Tech",
        "repo": "seshat-releases"
      }
    ]
  },
  "productName": "SeshatOS"
}
