{
  "name": "seshat-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:generate": "openapi-typescript ../seshat-server/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/schema.d.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@seshat/connector-catalog": "file:../shared/connector-catalog",
    "@tanstack/react-query": "^5.101.2",
    "antd": "^6.5.0",
    "dayjs": "^1.11.21",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.29.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
