# Copy to .env in this same directory (deploy/.env), then:
#   docker compose up --build

# Activates every profile-gated service (docling, minio, searxng) without
# needing `make deploy-up-full` or a `--profile` flag - plain
# `docker compose up` picks this up automatically (standard Compose env
# var). Set to a comma-separated subset (e.g. "docs,s3") instead if you
# don't want all three, or leave empty (the default) for the fast
# core-only stack.
COMPOSE_PROFILES=

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=seshat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=seshat_server

# ─── seshat-server ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Only required once a provider-setting (LLM API key) is created — the
# server starts fine without it, this just needs to be set before that.
SESHAT_SERVER_ENCRYPTION_KEY=

# Leave empty unless something calls the API directly from a browser on a
# different origin — the console reaches seshat-server through its own
# nginx reverse proxy (same-origin), so this isn't needed for that path.
SESHAT_SERVER_CORS_ALLOWED_ORIGINS=

# Empty by default so a plain `docker compose up` skips Docling. Either
# set COMPOSE_PROFILES above to include "docs" (or "full") and set this to
# http://docling:5001, or use `make deploy-up-docs` / `make deploy-up-full`
# which do both for you for that one run. This deploy-only variable is
# mapped to SESHAT_SERVER_DOCLING_URL inside docker-compose.yml - that's
# the name the container actually sees, but DEPLOY_DOCLING_URL is the name
# that has to be set here.
DEPLOY_DOCLING_URL=

# ─── Bootstrap admin (seeded automatically at startup) ─────────────────────
# Creates a platform super-admin the first time the server boots with no
# users yet — no more need to visit the one-shot /bootstrap wizard by hand.
# Safe to leave set across restarts: idempotent by email, an existing
# account at that email (including a password already changed since) is
# never touched. Leave both empty to skip seeding entirely.
SESHAT_SERVER_BOOTSTRAP_ADMIN_EMAIL=
SESHAT_SERVER_BOOTSTRAP_ADMIN_PASSWORD=

# ─── Outbound email (invitation accept links, password reset links) ───────
# Defaults point at the bundled mailpit service below - every email lands
# there instead of a real inbox, viewable at http://localhost:8025. Swap
# these to a real provider's SMTP relay once you're ready to send real
# email; leave SESHAT_SERVER_SMTP_HOST empty to disable sending entirely
# (both flows still work without it, just without email delivery).
SESHAT_SERVER_SMTP_HOST=mailpit
SESHAT_SERVER_SMTP_PORT=1025
SESHAT_SERVER_SMTP_USERNAME=
SESHAT_SERVER_SMTP_PASSWORD=
SESHAT_SERVER_SMTP_FROM=Seshat <noreply@seshat.local>

# This deployment's own console URL, used to build the links embedded in
# emails. Change this if you publish the console behind another
# hostname/port than the SESHAT_CONSOLE_PORT default below.
SESHAT_SERVER_PUBLIC_APP_URL=http://localhost:3000

# ─── MinIO (optional S3-compatible storage for corpus files) ──────────────
# Needs COMPOSE_PROFILES above to include "s3" (or "full") - or
# `make deploy-up-s3` / `make deploy-up-full` - to actually start. These
# are just the bundled MinIO's own root credentials, unrelated to any real
# cloud account. Change MINIO_ROOT_PASSWORD to your own value; if you also
# switch SESHAT_SERVER_STORAGE_PROVIDER to s3 below, mirror the same value
# into SESHAT_SERVER_S3_SECRET_ACCESS_KEY - they have to match.
MINIO_ROOT_USER=seshat
MINIO_ROOT_PASSWORD=changeme

# By default seshat-server stores corpus files on local disk — leave
# SESHAT_SERVER_STORAGE_PROVIDER empty to keep that. Set it to "s3" to
# switch to the bundled MinIO instead (also needs the profile above and a
# real MINIO_ROOT_PASSWORD echoed into S3_SECRET_ACCESS_KEY - see above):
SESHAT_SERVER_STORAGE_PROVIDER=
SESHAT_SERVER_S3_ENDPOINT=http://minio:9000
SESHAT_SERVER_S3_BUCKET=seshat-corpora
SESHAT_SERVER_S3_ACCESS_KEY_ID=seshat
SESHAT_SERVER_S3_SECRET_ACCESS_KEY=changeme
SESHAT_SERVER_S3_REGION=us-east-1

# ─── Host port mapping ─────────────────────────────────────────────────────
SESHAT_SERVER_PORT=8081
SESHAT_CONSOLE_PORT=3000
DOCLING_PORT=5001
SEARXNG_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Public/base URL advertised by the SearXNG container itself. Keep the
# default for local docker-compose usage; change it if you publish the
# service behind another hostname / reverse proxy.
SEARXNG_BASE_URL=http://localhost:8080/


# ─── Email / SMTP ─────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret