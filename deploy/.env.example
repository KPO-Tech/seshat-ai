# Copy to .env in this same directory (deploy/.env), then:
#   docker compose up --build

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=seshat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=seshat_server

# ─── seshat-server ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Only required once a provider-setting (LLM API key) is created — the
# server starts fine without it, this just needs to be set before that.
SESHAT_SERVER_ENCRYPTION_KEY=

# Leave empty unless something calls the API directly from a browser on a
# different origin — the console reaches seshat-server through its own
# nginx reverse proxy (same-origin), so this isn't needed for that path.
SESHAT_SERVER_CORS_ALLOWED_ORIGINS=

# Points seshat-server at the docling container in this compose file
# (converts PDF/DOCX/PPTX/XLSX/audio/images to markdown before a corpus
# file is ingested). Leave as-is to use it; set to empty and comment the
# `docling` service out in docker-compose.yml if you don't need
# binary-document ingestion and want a lighter/faster stack (docling's
# image is several GB, PyTorch + layout/OCR models).
SESHAT_SERVER_DOCLING_URL=http://docling:5001

# ─── MinIO (optional S3-compatible storage for corpus files) ──────────────
# Required if you keep the minio/minio-createbucket services in
# docker-compose.yml (comment them out instead if you don't want this).
# These are just the bundled MinIO's own root credentials, unrelated to any
# real cloud account.
MINIO_ROOT_USER=seshat
MINIO_ROOT_PASSWORD=changeme

# By default seshat-server stores corpus files on local disk — leave the
# three lines below as-is (empty) to keep that. Uncomment them to switch to
# the bundled MinIO instead (useful for testing S3-backed ingestion):
# SESHAT_SERVER_STORAGE_PROVIDER=s3
# SESHAT_SERVER_S3_ENDPOINT=http://minio:9000
# SESHAT_SERVER_S3_BUCKET=seshat-corpora
# SESHAT_SERVER_S3_ACCESS_KEY_ID=seshat
# SESHAT_SERVER_S3_SECRET_ACCESS_KEY=changeme
# SESHAT_SERVER_S3_REGION=us-east-1
SESHAT_SERVER_STORAGE_PROVIDER=
SESHAT_SERVER_S3_ENDPOINT=
SESHAT_SERVER_S3_BUCKET=
SESHAT_SERVER_S3_ACCESS_KEY_ID=
SESHAT_SERVER_S3_SECRET_ACCESS_KEY=
SESHAT_SERVER_S3_REGION=

# ─── Host port mapping ─────────────────────────────────────────────────────
SESHAT_SERVER_PORT=8081
SESHAT_CONSOLE_PORT=3000
SEARXNG_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Public/base URL advertised by the SearXNG container itself. Keep the
# default for local docker-compose usage; change it if you publish the
# service behind another hostname / reverse proxy.
SEARXNG_BASE_URL=http://localhost:8080/
