# Reverse-proxies the whole stack behind TLS. seshat-console's own nginx
# already reverse-proxies /api/* to seshat-server (see
# seshat-console/nginx.conf) — this just puts one more hop (TLS
# termination) in front of that, so seshat-server itself never needs to
# know about certificates.
#
# {$SESHAT_PUBLIC_DOMAIN} is read from the environment (set in deploy/.env).
# Caddy's automatic HTTPS decides the certificate source from the address
# itself, no extra config needed here: a real public hostname gets a real
# Let's Encrypt certificate via ACME; "localhost", a bare IP, or any
# hostname without a dot is treated as internal and gets a certificate from
# Caddy's own locally-trusted CA instead — which is what makes this
# profile testable without owning a domain (see deploy/README.md).
{$SESHAT_PUBLIC_DOMAIN} {
	reverse_proxy seshat-console:80
}
