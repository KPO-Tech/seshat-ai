{
  "name": "seshat-ui",
  "version": "0.1.0",
  "description": "SeshatOS Desktop",
  "main": "out/main/index.js",
  "author": {
    "name": "KPO-Tech",
    "email": "projectsengineer6@gmail.com"
  },
  "homepage": "https://github.com/KPO-Tech/seshat-ai",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "build:backend:win": "node ../scripts/build-desktop-sidecar.mjs windows amd64",
    "build:backend:linux": "node ../scripts/build-desktop-sidecar.mjs linux amd64",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build:backend:win && npm run build && electron-builder --win nsis",
    "package:linux": "npm run build:backend:linux && npm run build && electron-builder --linux AppImage deb",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.1",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@icon-park/react": "^1.4.2",
    "@tanstack/react-virtual": "^3.13.25",
    "electron-updater": "^6.6.2",
    "emoji-mart": "^5.6.0",
    "katex": "^0.16.22",
    "mermaid": "^11.13.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swr": "^2.3.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@unocss/reset": "^66.3.3",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.8.3",
    "unocss": "^66.3.3",
    "unocss-preset-extra": "^1.0.0",
    "vite": "^6.4.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "build": {
    "appId": "com.seshat.os",
    "productName": "SeshatOS",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KPO-Tech",
        "repo": "seshat-releases"
      }
    ]
  },
  "productName": "SeshatOS"
}
