# Nexus — Environment Configuration
# Copy to .env and fill in your values.

# ─── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=INFO
NEXUS_DEBUG=false

# ─── Bootstrap Admin (first-run only) ──────────────────────────────────────────
NEXUS_ADMIN_EMAIL=admin@example.com
NEXUS_ADMIN_PASSWORD=changeme

# ─── Auth ──────────────────────────────────────────────────────────────────────
NEXUS_ENABLE_SIGNUP=true
NEXUS_ENABLE_API_KEYS=true

# ─── Provider API Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── OAuth (optional — OpenAI device flow) ─────────────────────────────────────
# Register your own OAuth app at platform.openai.com and set the client ID here.
OPENAI_CLIENT_ID=

# ─── Web Search (pick one) ─────────────────────────────────────────────────────
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
SEARXNG_BASE_URL=

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero config):
NEXUS_DB_DRIVER=sqlite
NEXUS_DB_DSN=nexus.db
NEXUS_DB_AUTO_MIGRATE=true

# PostgreSQL (recommended for production):
# NEXUS_DB_DRIVER=postgres
# NEXUS_DB_DSN=postgresql://user:password@localhost:5432/nexus?sslmode=disable

# ─── RAG / Embedder (optional) ─────────────────────────────────────────────────
# Ollama (local, free):  ollama pull nomic-embed-text
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_URL=http://localhost:11434/v1
RAG_EMBEDDING_MODEL=nomic-embed-text

# OpenAI:
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_URL=https://api.openai.com/v1
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# ─── Vector Backend ────────────────────────────────────────────────────────────
NEXUS_VECTOR_BACKEND=sqlite
# pgvector:
# NEXUS_VECTOR_BACKEND=pgvector
# NEXUS_PGVECTOR_DSN=postgresql://user:password@localhost:5432/nexus?sslmode=disable

# ─── Storage ───────────────────────────────────────────────────────────────────
NEXUS_STORAGE_PROVIDER=local
NEXUS_STORAGE_LOCAL_PATH=./data/files

# S3 / MinIO:
# NEXUS_STORAGE_PROVIDER=s3
# NEXUS_STORAGE_S3_BUCKET=nexus
# NEXUS_STORAGE_S3_ENDPOINT=http://localhost:9000
# NEXUS_STORAGE_S3_ACCESS_KEY=
# NEXUS_STORAGE_S3_SECRET_KEY=
