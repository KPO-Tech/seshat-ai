---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import { dict, url } from '../i18n';
import type { Lang } from '../i18n';
import { postsFor, allPosts, translationOf, formatDate } from '../lib/blog';
import type { PostItem } from '../lib/blog';
import { blogPostingNode, SITE, GITHUB_RUNTIME } from '../lib/seo';
import { legal } from '../data/legal';

interface Props { lang: Lang; post: PostItem }
const { lang, post } = Astro.props;
const t = dict(lang).blog;
const d = post.entry.data;
const { Content, headings } = await render(post.entry);
const same = await postsFor(lang);
const related = same
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => Number(b.entry.data.category === d.category) - Number(a.entry.data.category === d.category))
  .slice(0, 2);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const twin = translationOf(post, (await allPosts()).filter((p) => p.lang === other));
const path = `${url(lang, 'blog')}/${post.slug}`;
const altHrefs = twin ? ({ [lang]: path, [other]: `${url(other, 'blog')}/${twin.slug}` } as Record<Lang, string>) : undefined;
const image = d.cover ?? `/og/og-${lang}.png`;
const seoTitle = d.seoTitle ?? (d.title.length > 52 ? d.title : `${d.title} | Seshat AI`);
const isContactCta = d.category === 'pme' || d.category === 'public';
const cta = d.category === 'pme' ? t.cta.pme : d.category === 'public' ? t.cta.public : t.cta.dev;
// Sommaire : les titres de section de l'article, sans la bibliographie finale.
const toc = headings.filter((h) => h.depth === 2 && !/^sources$/i.test(h.text.trim()));
const minutes = (n: number) => `${n} ${t.labels.minutes}`;
---

<Base
  title={seoTitle}
  description={d.description}
  lang={lang}
  page="blog"
  ogType="article"
  ogImage={image}
  altHrefs={altHrefs}
  monolingual={!twin}
  feed={`${url(lang, 'blog')}/rss.xml`}
  crumbs={[{ name: 'Seshat AI', path: url(lang, 'home') }, { name: 'Blog', path: url(lang, 'blog') }, { name: d.title, path }]}
  schema={[blogPostingNode({ url: new URL(path, SITE).href, headline: d.title, description: d.description, datePublished: d.date, dateModified: d.updated, lang, image: new URL(image, SITE).href, section: t.categories[d.category], keywords: d.tags })]}
>
  <article class="post">
    <div class={`post-layout${toc.length > 1 ? '' : ' post-layout-solo'}`}>
      <div class="post-main">
        <header class="post-head">
          <p class="post-crumb"><a href={url(lang, 'blog')}>{t.labels.back}</a></p>
          <p class="post-card-tags">
            <span class={`pill pill-${d.category}`}>{t.categories[d.category]}</span>
            {d.draft && <span class="pill pill-draft">{t.labels.draft}</span>}
          </p>
          <h1>{d.title}</h1>
          <p class="post-standfirst">{d.description}</p>
          <p class="post-meta">
            <span>{t.labels.by} {legal.usageName}</span>
            <span><Icon name="calendar-blank" /><time datetime={d.date}>{formatDate(d.date, lang)}</time></span>
            {d.updated && <span><Icon name="clock-counter-clockwise" />{t.labels.updated} <time datetime={d.updated}>{formatDate(d.updated, lang)}</time></span>}
            <span><Icon name="clock" />{minutes(post.minutes)}</span>
          </p>
          {d.cover && <img class="post-img" src={d.cover} alt="" width="1200" height="630" decoding="async" fetchpriority="high" />}
          {toc.length > 1 && (
            <details class="post-toc-m" data-pagefind-ignore>
              <summary>{lang === 'fr' ? 'Sommaire' : 'Contents'}</summary>
              <ol class="toc-list toc-m-list">
                {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              </ol>
            </details>
          )}
        </header>

        <div class="post-body">
          <div class="prose"><Content /></div>

          <aside class="post-cta">
            <h2>{cta.title}</h2>
            <p>{cta.text}</p>
            <p class="post-cta-actions">
              {isContactCta
                ? <a class="btn btn-primary" href={url(lang, 'contact')}>{cta.button} <Arrow /></a>
                : <>
                    <a class="btn btn-primary" href="/en/docs">{t.cta.dev.button} <Arrow /></a>
                    <a class="btn btn-light" href={GITHUB_RUNTIME} rel="noopener">{t.cta.dev.second}</a>
                  </>}
            </p>
          </aside>

          {related.length > 0 && (
            <section class="post-related">
              <h2>{t.labels.related}</h2>
              <ul class="blog-grid">
                {related.map((p) => (
                  <li>
                    <a class="post-card" href={`${url(lang, 'blog')}/${p.slug}`}>
                      <span class="post-card-tags"><span class={`pill pill-${p.entry.data.category}`}>{t.categories[p.entry.data.category]}</span></span>
                      <h3>{p.entry.data.title}</h3>
                      <span class="post-meta"><time datetime={p.entry.data.date}>{formatDate(p.entry.data.date, lang)}</time> · {minutes(p.minutes)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>

      {toc.length > 1 && (
        <aside class="post-toc" aria-label={lang === 'fr' ? 'Sommaire' : 'Contents'} data-pagefind-ignore>
          <div class="toc-card">
            <p class="toc-head">
              <span>{lang === 'fr' ? 'Sommaire' : 'Contents'}</span>
              <span class="toc-pct" data-pct>0 %</span>
            </p>
            <div class="toc-bar" aria-hidden="true"><span data-progress></span></div>
            <ol class="toc-list">
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </div>
        </aside>
      )}
    </div>
  </article>
</Base>

<script is:inline>
  (function () {
    // Barre de lecture et section en cours : le sommaire suit l'avancement dans l'article.
    var body = document.querySelector('.post-body');
    var bar = document.querySelector('[data-progress]');
    var pct = document.querySelector('[data-pct]');
    var links = [].slice.call(document.querySelectorAll('.toc-list a, .toc-m-list a'));
    var targets = links
      .map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); })
      .filter(Boolean);
    if (!body || !links.length) return;
    function progress() {
      var r = body.getBoundingClientRect();
      var span = r.height - window.innerHeight;
      var p = span > 0 ? (-r.top) / span : 1;
      p = Math.min(1, Math.max(0, p));
      if (bar) bar.style.transform = 'scaleX(' + p.toFixed(3) + ')';
      if (pct) pct.textContent = Math.round(p * 100) + ' %';
      var current = null;
      for (var i = 0; i < targets.length; i++) {
        if (targets[i].getBoundingClientRect().top < 120) current = links[i];
      }
      links.forEach(function (a) { a.removeAttribute('aria-current'); });
      if (current) {
        var href = current.getAttribute('href');
        links.forEach(function (a) {
          if (a.getAttribute('href') === href) a.setAttribute('aria-current', 'true');
        });
      }
    }
    var tick = false;
    window.addEventListener('scroll', function () {
      if (tick) return;
      tick = true;
      requestAnimationFrame(function () { progress(); tick = false; });
    }, { passive: true });
    window.addEventListener('resize', progress);
    progress();
  })();
</script>
