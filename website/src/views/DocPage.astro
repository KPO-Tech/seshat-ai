---
import { render } from 'astro:content';
import Docs from '../layouts/Docs.astro';
import { docsFor, groupBySection, sortItems } from '../lib/docs';
import { dict } from '../i18n';
import type { DocItem } from '../lib/docs';

interface Props { item: DocItem }
const { item } = Astro.props;
const items = sortItems(await docsFor());
const groups = groupBySection(items);
const index = items.findIndex((i) => i.slug === item.slug);
const { Content, headings } = await render(item.entry);
const d = dict('en').docs;
---
<Docs
  title={item.entry.data.title}
  description={item.entry.data.description}
  slug={item.slug}
  groups={groups}
  headings={headings}
  prev={index > 0 ? items[index - 1] : undefined}
  next={index < items.length - 1 ? items[index + 1] : undefined}
  updated={item.entry.data.updated}
  sectionTitle={d.sections[item.entry.data.section].title}
>
  <Content />
</Docs>
