---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { dict } from '../i18n';
import type { Lang } from '../i18n';
import { legal } from '../data/legal';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang).contact;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '/api/contact';
// Clé publique du widget Cloudflare Turnstile, posée au build. Sans elle, le widget n'apparaît pas et la
// vérification côté serveur reste inactive : les deux clés se configurent en même temps (voir functions/api/contact.ts).
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<Base title={t.meta.title} description={t.meta.description} lang={lang} page="contact">
  <header class="page-head contact-head">
    <div class="wrap">
      <h1>{t.head.title}</h1>
      <p class="lead">{t.head.lead}</p>
    </div>
  </header>

  <section class="block contact-block">
    <div class="wrap contact-grid">
      <form
        class="form reveal"
        method="post"
        action={endpoint}
        data-endpoint={endpoint}
        data-sending={t.status.sending}
        data-ok={t.status.ok}
        data-error={t.status.error}
        data-rejected={t.status.rejected}
        data-challenge={t.status.challenge}
        data-rate={t.status.rate}
        data-unavailable={t.status.unavailable}
        novalidate
      >
        <div class="field half">
          <label for="nom">{t.labels.name}</label>
          <input id="nom" name="nom" type="text" autocomplete="name" required />
        </div>
        <div class="field half">
          <label for="email">{t.labels.email}</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field half">
          <label for="entreprise">{t.labels.company}</label>
          <input id="entreprise" name="entreprise" type="text" autocomplete="organization" />
        </div>
        <div class="field half">
          <label for="taille">{t.labels.size}</label>
          <select id="taille" name="taille">
            <option value="">{t.labels.sizeNone}</option>
            {t.labels.sizes.map((s) => <option>{s}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="message">{t.labels.message}</label>
          <textarea id="message" name="message" rows="4" required></textarea>
          <p class="help">{t.labels.help}</p>
        </div>
        <div class="field check">
          <input id="consent" name="consent" type="checkbox" required />
          <label for="consent">{t.labels.consentA}<a href="/confidentialite" hreflang="fr">{t.labels.consentLink}</a></label>
        </div>
        <p class="help form-note">{t.next.note}</p>
        <div class="field hp" aria-hidden="true">
          <label for="site">{t.labels.honeypot}</label>
          <input id="site" name="site" type="text" tabindex="-1" autocomplete="off" />
        </div>
        {turnstileKey && <div id="ts-slot" class="ts-slot" data-sitekey={turnstileKey} data-lang={lang} />}
        <button class="btn btn-primary" type="submit">{t.labels.submit} <Arrow /></button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>

      <aside class="next reveal" style="--d:100ms">
        <h2>{t.next.title}</h2>
        <ol>
          {t.next.steps.map((s, i) => (
            <li><span class="hexnum" aria-hidden="true"><span>{i + 1}</span></span><p><strong>{s.b}</strong>{s.r}</p></li>
          ))}
        </ol>
        <div class="direct">
          <h3>{t.direct.title}</h3>
          <ul>
            <li><span>{t.direct.contactLabel}</span><a href={`mailto:${legal.email}`}>{legal.email}</a><small>{t.direct.contactText}</small></li>
            <li><span>{t.direct.supportLabel}</span><a href={`mailto:${legal.supportEmail}`}>{legal.supportEmail}</a><small>{t.direct.supportText}</small></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
  <script is:inline>
    (function () {
      var form = document.querySelector('.form');
      if (!form) return;
      var status = form.querySelector('.status');
      var slot = document.getElementById('ts-slot');
      var widgetId = null;
      var challengeBroken = false;

      // Le script Turnstile arrive en asynchrone : on attend son API avant de dessiner le widget, et on
      // garde son identifiant pour pouvoir le réinitialiser (un jeton ne sert qu'une seule fois).
      function drawWidget(tries) {
        if (!slot || !slot.dataset.sitekey) return;
        if (window.turnstile && window.turnstile.render) {
          widgetId = window.turnstile.render(slot, {
            sitekey: slot.dataset.sitekey,
            theme: 'auto',
            language: slot.dataset.lang || 'auto',
            size: 'flexible',
            action: 'contact',
            'error-callback': function () {
              challengeBroken = true;
            },
          });
          return;
        }
        if ((tries || 0) < 200) setTimeout(function () { drawWidget((tries || 0) + 1); }, 150);
      }
      drawWidget(0);

      // Codes d'échec renvoyés par l'API : chacun a son message, le reste retombe sur le message générique.
      var statuses = {
        invalid: form.dataset.rejected,
        spam: form.dataset.rejected,
        challenge: form.dataset.challenge,
        rate_limited: form.dataset.rate,
        not_configured: form.dataset.unavailable,
      };

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        status.className = 'status';
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        if (form.site.value) return;
        var endpoint = form.dataset.endpoint;
        if (!endpoint) {
          status.classList.add('err');
          status.textContent = form.dataset.unavailable;
          return;
        }
        var body = new FormData(form);
        // Sans jeton valide, inutile d'appeler l'API : elle refusera l'envoi.
        if (slot && slot.dataset.sitekey) {
          if (challengeBroken || widgetId === null || !window.turnstile) {
            status.classList.add('err');
            status.textContent = form.dataset.challenge;
            return;
          }
          var token = window.turnstile.getResponse(widgetId);
          if (!token) {
            status.classList.add('err');
            status.textContent = form.dataset.challenge;
            return;
          }
          body.set('cf-turnstile-response', token);
        }
        status.textContent = form.dataset.sending;
        fetch(endpoint, { method: 'POST', body: body, headers: { Accept: 'application/json' } })
          .then(function (r) {
            return r
              .json()
              .catch(function () { return {}; })
              .then(function (b) { return { ok: r.ok, body: b }; });
          })
          .then(function (res) {
            if (!res.ok || !res.body || res.body.ok === false) throw new Error((res.body && res.body.error) || 'http');
            form.reset();
            status.classList.add('ok');
            status.textContent = form.dataset.ok;
          })
          .catch(function (err) {
            status.classList.add('err');
            status.textContent = statuses[err.message] || form.dataset.error;
          })
          .then(function () {
            // Jeton consommé : on en redemande un pour un éventuel second message.
            if (widgetId !== null && window.turnstile) window.turnstile.reset(widgetId);
          });
      });
    })();
  </script>
</Base>
