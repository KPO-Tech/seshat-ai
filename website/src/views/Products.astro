---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Check from '../components/Check.astro';
import Icon from '../components/Icon.astro';
import Stack from '../components/Stack.astro';
import { dict, url } from '../i18n';
import type { PageKey } from '../i18n';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang).products;

// Éléments qui ne dépendent pas de la langue.
const detail: PageKey[] = ['productSeshat', 'productSeshatOS', 'productSeshatCloud'];
const more = dict(lang).productPages.more;
const meta = [
  { name: 'Seshat', logo: '/brand/seshat.svg', tone: 'ok', dark: false, code: 'https://github.com/KPO-Tech/seshat-runtime', stage: 3 },
  { name: 'SeshatOS', logo: '/brand/seshatos.svg', tone: 'wip', dark: true, code: 'https://github.com/KPO-Tech/SeshatOS', stage: 1 },
  { name: 'SeshatCloud', logo: '/brand/seshatcloud.svg', tone: 'wip', dark: false, code: '', stage: 1 },
];
const stages = t.stages.map((name, i) => ({ name, items: meta.filter((m) => m.stage === i) }));
---
<Base title={t.meta.title} description={t.meta.description} lang={lang} page="products">
  <header class="page-head contact-head">
    <div class="wrap">
      <h1>{t.head.title}</h1>
      <p class="lead">{t.head.lead}</p>
    </div>
  </header>

  <section class="block" style="padding-top:28px;padding-bottom:40px">
    <div class="wrap">
      <ol class="scale reveal" aria-label={t.scaleAria}>
        {stages.map((s, i) => (
          <li class={s.items.length ? 'has' : ''} style={`--k:${i}`}>
            <span class="scale-name">{s.name}</span>
            <span class="scale-bar"></span>
            <span class="scale-items">
              {s.items.map((it) => <span class="scale-chip"><img src={it.logo} alt="" width="22" height="22" />{it.name}</span>)}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Stack t={t.stack} />

  <section class="block" style="padding-top:24px">
    <div class="wrap">
      <div class="prods">
        {t.items.map((p, i) => (
          <article class={`prod ${meta[i].dark ? 'dark' : ''} reveal`}>
            <div class="prod-id">
              <img src={meta[i].logo} alt="" width="64" height="64" />
              <h2>{meta[i].name}</h2>
              <span class={`badge ${meta[i].tone}`}>{p.badge}</span>
              <p class="prod-lic">{p.licence}</p>
              {meta[i].code
                ? <a class="link" href={meta[i].code} rel="noopener"><Icon name="github-logo" /> {t.codeLabel} <Arrow /></a>
                : <p class="prod-private"><Icon name="lock-key" /> {t.privateLabel}</p>}
            </div>
            <div>
              <p class="prod-what">{p.what}</p>
              <ul class="deliver">
                {p.points.map((x) => <li><Check />{x}</li>)}
              </ul>
              <p class="prod-status">{p.status}</p>
          <p class="prod-more"><a class="link" href={url(lang, detail[i])}>{more} <Arrow /></a></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <div class="cta-box">
        <h2 class="reveal">{t.cta.title}</h2>
        <div class="reveal" style="--d:100ms">
          <p>{t.cta.text}</p>
          <a class="btn btn-primary" href={url(lang, 'contact')}>{t.cta.button} <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>
