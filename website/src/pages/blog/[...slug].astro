---
import BlogPost from '../../views/BlogPost.astro';
import { postsFor } from '../../lib/blog';

export async function getStaticPaths() {
  return (await postsFor('fr')).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<BlogPost lang="fr" post={post} />
