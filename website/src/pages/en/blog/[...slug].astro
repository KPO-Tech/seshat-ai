---
import BlogPost from '../../../views/BlogPost.astro';
import { postsFor } from '../../../lib/blog';

export async function getStaticPaths() {
  return (await postsFor('en')).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<BlogPost lang="en" post={post} />
