---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable | Seshat AI" description="Cette page n'existe pas ou a changé d'adresse." noindex>
  <header class="page-head contact-head">
    <div class="wrap">
      <h1>Page introuvable</h1>
      <p class="lead">Cette adresse n'existe pas, ou la page a changé de place. Page not found.</p>
      <p style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-primary" href="/">Accueil</a>
        <a class="btn btn-ghost" href="/services">Services</a>
        <a class="btn btn-ghost" href="/en/docs">Documentation</a>
        <a class="btn btn-ghost" href="/contact">Contact</a>
      </p>
    </div>
  </header>
</Base>
