---
import '../styles/global.css';
import globeRaw from '@phosphor-icons/core/assets/bold/globe-bold.svg?raw';
import { dict, locales, langNames, ogLocales, url, docUrl, defaultLang } from '../i18n';
import type { Lang, PageKey } from '../i18n';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import groteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import { legal } from '../data/legal';
import { hasPosts } from '../lib/blog';
import { SITE, graph, organizationNode, founderNode, websiteNode, breadcrumbNode, webPageNode } from '../lib/seo';

const globe = globeRaw.replace('<svg ', '<svg class="ico" aria-hidden="true" focusable="false" ');

// `page` : la page traduite affichée (sert au menu, au sélecteur de langue et à hreflang).
// Sans `page`, la page n'existe que dans une langue (pages légales) : pas de sélecteur.
interface Props { title: string; description: string; lang?: Lang; page?: PageKey; altHrefs?: Record<Lang, string>; shell?: boolean; monolingual?: boolean; ogImage?: string; ogType?: 'website' | 'article'; noindex?: boolean; schema?: object[]; crumbs?: { name: string; path: string }[]; feed?: string }
// `shell` : pages sans en-tête ni pied de page du site (la documentation fournit sa propre barre).
const { title, description, lang = defaultLang, page, altHrefs, shell = false, monolingual = false, ogImage, ogType = 'website', noindex = false, schema = [], crumbs, feed } = Astro.props;
const c = dict(lang).common;
// Le lien « Blog » n'apparaît que lorsqu'il existe au moins un article publié.
const blogOn = await hasPosts();
const navItems = c.nav.filter((n) => n.page !== 'blog' || blogOn);
const groups = c.groups.filter((g) => g.page !== 'blog' || blogOn);
// « Documentation » ouvre directement la première page (avec la barre latérale), pas la page d'accueil de la doc.
const navHref = (key: string) => key === 'docs' ? docUrl('getting-started/installation') : url(lang, key as PageKey);
const inGroup = (g: (typeof groups)[number]) => g.items?.some((i) => i.page === page);
const home = page ? url(lang, 'home') : url(defaultLang, 'home');
// `monolingual` : page qui n'existe que dans une langue (documentation) : ni sélecteur ni hreflang.
const alternates = monolingual ? []
  : altHrefs
  ? locales.map((l) => ({ lang: l, href: altHrefs[l] }))
  : page ? locales.map((l) => ({ lang: l, href: url(l, page) })) : [];
const others = alternates.filter((a) => a.lang !== lang);
// build.format 'file' : les pages compilées s'appellent services.html mais sont servies sur /services.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);
const image = new URL(ogImage ?? `/og/og-${lang}.png`, Astro.site).href;
const ogAlt = lang === 'fr' ? 'Seshat AI, conseil et intégration d’IA souveraine' : 'Seshat AI, sovereign AI consulting and integration';
const navLabel = c.nav.find((n) => n.page === page)?.label;
const shortName = navLabel ?? title.split(' | ')[0];
const isHome = page === 'home';
// Fil d'Ariane : accueil > page (les pages de documentation fournissent le leur).
const trail = crumbs ?? (page && !isHome && !shell ? [{ name: 'Seshat AI', path: home }, { name: shortName, path: cleanPath }] : []);
const nodes: object[] = [
  ...(isHome ? [organizationNode(lang), founderNode(), websiteNode(lang)] : []),
  ...(!isHome && !shell ? [webPageNode({ url: canonical.href, name: shortName, description, lang })] : []),
  ...(trail.length > 1 ? [breadcrumbNode(trail)] : []),
  ...schema,
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f1ea" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {feed && <link rel="alternate" type="application/rss+xml" title="Seshat AI" href={feed} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site)} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((a) => a.lang === defaultLang)!.href, Astro.site)} />}
    <meta property="og:site_name" content="Seshat AI" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocales[a.lang]} />)}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {nodes.length > 0 && <script type="application/ld+json" set:html={graph(nodes)} />}
    <script is:inline data-themed={shell ? 'true' : 'false'}>
      document.documentElement.classList.add('js');
      var th = 'light';
      if (document.currentScript.dataset.themed === 'true') {
        try { th = localStorage.getItem('theme'); } catch (e) {}
        if (th !== 'light' && th !== 'dark') th = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', th);
    </script>
  </head>
  <body class={shell ? 'shell' : undefined}>
    <a class="skip" href="#contenu">{c.skip}</a>
    {!shell && (<header class="site-header">
      <div class="wrap">
        <a class="brand" href={home} aria-label={c.brandAria}>
          <img class="logo-light" src="/brand/mark-on-light.svg" alt="" width="34" height="34" />
          <img class="logo-dark" src="/brand/mark-on-dark.svg" alt="" width="34" height="34" />
          <span class="brand-text">Seshat AI</span>
        </a>
        <nav class="nav" aria-label={c.navAria}>
          {groups.map((g) => g.items ? (
            <div class="dd">
              <button class="dd-btn" type="button" aria-haspopup="true" aria-current={inGroup(g) ? 'true' : undefined}>{g.label}<svg class="dd-caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
              <div class="dd-panel">
                {g.items.map((i) => <a href={navHref(i.page)} aria-current={page === i.page ? 'page' : undefined}>{i.label}</a>)}
              </div>
            </div>
          ) : <a href={url(lang, g.page as PageKey)} aria-current={page === g.page ? 'page' : undefined}>{g.label}</a>)}
        </nav>
        <div class="actions">
          <a class="btn btn-primary btn-sm" href={url(lang, 'contact')}><span class="cta-long">{c.cta}</span><span class="cta-short">{c.ctaShort}</span></a>
          {others.length === 1 && (
            <a class="lang-btn" href={others[0].href} hreflang={others[0].lang} lang={others[0].lang} title={langNames[others[0].lang]} aria-label={`${c.langSwitch} : ${langNames[others[0].lang]}`}>
              <Fragment set:html={globe} />{others[0].lang.toUpperCase()}
            </a>
          )}
          {others.length > 1 && (
            <details class="lang-menu">
              <summary aria-label={c.langSwitch}><Fragment set:html={globe} />{lang.toUpperCase()}</summary>
              <ul>
                {alternates.map((a) => (
                  <li><a href={a.href} hreflang={a.lang} lang={a.lang} aria-current={a.lang === lang ? 'true' : undefined}>{langNames[a.lang]}</a></li>
                ))}
              </ul>
            </details>
          )}
          <button class="menu-toggle" type="button" aria-label={c.menu} aria-expanded="false" aria-controls="mnav"><span></span><span></span><span></span></button>
        </div>
      </div>
    </header>)}
    {!shell && (<nav class="mnav" id="mnav" aria-label={c.navAria} hidden>
      {groups.map((g) => g.items ? (
        <div class="mgroup">
          <span class="mgroup-label">{g.label}</span>
          {g.items.map((i) => <a href={navHref(i.page)} aria-current={page === i.page ? 'page' : undefined}>{i.label}</a>)}
        </div>
      ) : <a href={url(lang, g.page as PageKey)} aria-current={page === g.page ? 'page' : undefined}>{g.label}</a>)}
    </nav>)}
    <main id="contenu"><slot /></main>
    {!shell && (<footer class="site-footer">
      <img class="foot-mark logo-light" src="/brand/mark-on-light.svg" alt="" width="260" height="260" />
      <img class="foot-mark logo-dark" src="/brand/mark-on-dark.svg" alt="" width="260" height="260" />
      <div class="wrap">
        <div class="foot-top">
          <div>
            <a class="brand" href={home}>
              <img class="logo-light" src="/brand/mark-on-light.svg" alt="" width="34" height="34" />
              <img class="logo-dark" src="/brand/mark-on-dark.svg" alt="" width="34" height="34" />
              Seshat AI
            </a>
            <p class="about">{c.footer.tagline}</p>
          </div>
          <nav aria-label={c.footer.navAria}>
            <ul class="foot-links">
              {navItems.map((n) => <li><a href={url(lang, n.page as PageKey)}>{n.label}</a></li>)}
              <li><a href={url(lang, 'contact')}>{c.footer.contact}</a></li>
              <li><a href={`mailto:${legal.supportEmail}`}>{c.footer.support}</a></li>
              <li><a href="https://github.com/KPO-Tech" rel="noopener">{c.footer.github}</a></li>
            </ul>
          </nav>
        </div>
        <div class="foot-bottom">
          <p>{c.footer.copyright}</p>
          <ul>
            <li><a href="/mentions-legales" hreflang="fr">{c.footer.legal}</a></li>
            <li><a href="/confidentialite" hreflang="fr">{c.footer.privacy}</a></li>
          </ul>
        </div>
      </div>
    </footer>)}
    <script is:inline>
      (function () {
        var btn = document.querySelector('.theme-toggle');
        if (btn) btn.addEventListener('click', function () {
          var root = document.documentElement;
          var cur = root.getAttribute('data-theme') || 'light';
          var next = cur === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var mq = document.body.classList.contains('shell') && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
        if (mq && mq.addEventListener) mq.addEventListener('change', function (e) {
          var saved = null;
          try { saved = localStorage.getItem('theme'); } catch (x) {}
          if (saved !== 'light' && saved !== 'dark') document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        });
      })();
      (function () {
        var btn = document.querySelector('.menu-toggle');
        var panel = document.getElementById('mnav');
        if (!btn || !panel) return;
        function set(open) { panel.hidden = !open; btn.setAttribute('aria-expanded', String(open)); document.documentElement.classList.toggle('menu-open', open); }
        btn.addEventListener('click', function () { set(panel.hidden); });
        panel.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
        window.addEventListener('resize', function () { if (window.innerWidth > 900) set(false); });
      })();
    </script>
    <script is:inline>
      (function () {
        var menu = document.querySelector('.lang-menu');
        if (!menu) return;
        document.addEventListener('click', function (e) { if (!menu.contains(e.target)) menu.removeAttribute('open'); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') menu.removeAttribute('open'); });
      })();
    </script>
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { threshold: 0.15 });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
  </body>
</html>
