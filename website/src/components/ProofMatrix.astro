---
// Matrice de preuve : 23 systèmes RAG publics, quatre colonnes.
// Un point plein signifie « la source publique le documente » ; un point vide
// signifie « la source n'en dit rien », jamais « la fonction est absente ».
type Statut = 'service' | 'pilote' | 'demo' | 'projet';

interface Row {
  system: string;
  org: string;
  statut: Statut;
  citation: boolean;
  droits: boolean;
  evaluation: boolean;
}

const rows: Row[] = [
  { system: 'AIBots', org: 'Singapour', statut: 'service', citation: false, droits: true, evaluation: false },
  { system: 'Assist', org: 'Royaume-Uni', statut: 'service', citation: true, droits: false, evaluation: true },
  { system: 'Leasing Desk Guide Bot', org: 'GSA, États-Unis', statut: 'service', citation: false, droits: false, evaluation: false },
  { system: 'Pricing Policy Chatbot', org: 'GSA, États-Unis', statut: 'pilote', citation: false, droits: false, evaluation: false },
  { system: 'LaborMatch IQ', org: 'GSA, États-Unis', statut: 'projet', citation: false, droits: false, evaluation: false },
  { system: 'AI Chatbot', org: 'Caroline du Nord', statut: 'service', citation: false, droits: false, evaluation: false },
  { system: 'nebulaONE', org: 'Minnesota, États-Unis', statut: 'pilote', citation: false, droits: false, evaluation: false },
  { system: 'Ask the EP Archives', org: 'Parlement européen', statut: 'service', citation: false, droits: false, evaluation: false },
  { system: 'ECBot', org: 'BCE', statut: 'service', citation: true, droits: false, evaluation: false },
  { system: 'RAG analyse de crises', org: 'JRC', statut: 'demo', citation: false, droits: false, evaluation: false },
  { system: 'RAG garanties nucléaires', org: 'JRC', statut: 'demo', citation: false, droits: false, evaluation: false },
  { system: 'KIRA', org: 'Allemagne', statut: 'pilote', citation: true, droits: false, evaluation: false },
  { system: 'Outil Digdir', org: 'Norvège', statut: 'pilote', citation: false, droits: false, evaluation: false },
  { system: 'Seoul Data Hub', org: 'Corée du Sud', statut: 'service', citation: true, droits: false, evaluation: true },
  { system: 'China Maritime', org: 'Chine', statut: 'service', citation: true, droits: false, evaluation: true },
  { system: 'Annotation RAG', org: 'Chine, NDA', statut: 'service', citation: false, droits: false, evaluation: true },
  { system: 'Sanshui Assistant', org: 'Chine, Foshan', statut: 'service', citation: false, droits: false, evaluation: false },
  { system: 'Policy Navigator', org: 'Rwanda', statut: 'projet', citation: false, droits: false, evaluation: false },
  { system: 'GovBot', org: 'Kenya', statut: 'pilote', citation: true, droits: false, evaluation: false },
  { system: 'CGU-Insight', org: 'Brésil', statut: 'service', citation: false, droits: false, evaluation: false },
  { system: 'ChatTCU', org: 'Brésil', statut: 'service', citation: false, droits: false, evaluation: false },
  { system: 'NFRA Insight Bot', org: 'Inde', statut: 'projet', citation: false, droits: false, evaluation: false },
  { system: 'SEABIS', org: 'Japon', statut: 'demo', citation: true, droits: false, evaluation: false },
];

const statuts: Record<Statut, string> = {
  service: 'Service',
  pilote: 'Pilote',
  demo: 'Démo',
  projet: 'Projet',
};

const total = rows.length;
const nbEval = rows.filter((r) => r.evaluation).length;
const nbDroits = rows.filter((r) => r.droits).length;
const nbCitation = rows.filter((r) => r.citation).length;
---

<figure class="pm" aria-labelledby="pm-title">
  <p id="pm-title" class="pm-title">Ce que 23 systèmes et projets RAG publics documentent</p>

  <div class="pm-stats">
    <div class="pm-stat pm-stat-eval">
      <strong>{nbEval} / {total}</strong>
      <span>publient un chiffre de qualité ou de bénéfice</span>
    </div>
    <div class="pm-stat pm-stat-droits">
      <strong>{nbDroits} / {total}</strong>
      <span>documentent la classification des documents</span>
    </div>
    <div class="pm-stat pm-stat-cout">
      <strong>0 / {total}</strong>
      <span>publient un coût unitaire</span>
    </div>
  </div>

  <p class="pm-legend">
    <span class="pm-status pm-service">Service</span> déployé ou en usage
    <span class="pm-status pm-pilote">Pilote</span>
    <span class="pm-status pm-demo">Démo</span>
    <span class="pm-status pm-projet">Projet</span>
    <span class="pm-dot on" aria-hidden="true"></span> documenté
    <span class="pm-dot" aria-hidden="true"></span> non documenté
  </p>

  <div class="pm-scroll">
    <table class="pm-table">
      <caption class="sr-only">
        Matrice de preuve de {total} systèmes et projets RAG publics. Quatre colonnes :
        statut, citation documentée ({nbCitation} sur {total}), droits d’accès documentés
        ({nbDroits} sur {total}) et évaluation publiée ({nbEval} sur {total}). Un point plein
        signifie que la source publique le documente ; un point vide, qu’elle n’en dit rien.
      </caption>
      <thead>
        <tr>
          <th scope="col">Système</th>
          <th scope="col">Statut</th>
          <th scope="col"><abbr title="Citation documentée">Cite</abbr></th>
          <th scope="col"><abbr title="Droits d’accès documentés">Droits</abbr></th>
          <th scope="col"><abbr title="Évaluation publiée">Éval.</abbr></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row" class="pm-name">
              <strong>{r.system}</strong>
              <small>{r.org}</small>
            </th>
            <td><span class={`pm-status pm-${r.statut}`}>{statuts[r.statut]}</span></td>
            <td class="pm-c"><span class={`pm-dot${r.citation ? ' on' : ''}`} aria-hidden="true"></span><span class="sr-only">{r.citation ? 'citation documentée' : 'citation non documentée'}</span></td>
            <td class="pm-c"><span class={`pm-dot${r.droits ? ' on' : ''}`} aria-hidden="true"></span><span class="sr-only">{r.droits ? 'droits documentés' : 'droits non documentés'}</span></td>
            <td class="pm-c"><span class={`pm-dot${r.evaluation ? ' on' : ''}`} aria-hidden="true"></span><span class="sr-only">{r.evaluation ? 'évaluation publiée' : 'évaluation non publiée'}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <figcaption>
    Le RAG public produit des systèmes ; il ne produit pas encore de preuves comparables.
    Un point vide signifie qu’aucune source publique ne décrit la fonction, pas qu’elle
    n’existe pas. <strong>{nbCitation} cas sur {total}</strong> documentent au moins une
    citation, mais une citation affichée n’est pas une citation vérifiée.
  </figcaption>
</figure>
