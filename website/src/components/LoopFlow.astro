---
// Schéma de la boucle de requête : cinq étapes, la dernière renvoie à la deuxième.
import Icon from './Icon.astro';

interface Step { icon: string; title: string; text: string }
interface Props { steps: Step[]; loopBack: string; aria: string }
const { steps, loopBack, aria } = Astro.props;
---
<div class="loop">
  <ol class="lf-steps" aria-label={aria}>
    {steps.map((s, i) => (
      <li style={`--i:${i}`}>
        <span class="lf-n">{i + 1}</span>
        <span class="lf-chip"><Icon name={s.icon} /></span>
        <strong>{s.title}</strong>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
  <div class="lf-back" aria-hidden="true"><span><Icon name="arrows-clockwise" /> {loopBack}</span></div>
  <p class="lf-back-text">{loopBack}</p>
</div>

<style>
  .loop { margin-top: 40px; }
  .lf-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px; counter-reset: s; }
  .lf-steps li { position: relative; display: grid; gap: 10px; align-content: start; padding: 22px 18px 20px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .lf-steps li + li::before { content: ''; position: absolute; top: 50px; left: -28px; width: 28px; height: 2px; background: var(--line); }
  .lf-steps li + li::after { content: ''; position: absolute; top: 45px; left: -9px; width: 8px; height: 8px; border-top: 2px solid var(--text2); border-right: 2px solid var(--text2); transform: rotate(45deg); }
  .lf-n { position: absolute; top: -12px; left: 16px; width: 24px; height: 24px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 0.8rem; font-weight: 700; }
  .lf-chip { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 12px; background: var(--bg); border: 1px solid var(--line); color: var(--accent-text); }
  .lf-chip :global(.pi) { width: 22px; height: 22px; fill: currentColor; }
  strong { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.25; }
  p { margin: 0; color: var(--text2); font-size: 0.92rem; line-height: 1.45; }
  .lf-back { margin: 0 10% 0 30%; height: 34px; border: 2px dashed color-mix(in srgb, var(--accent) 70%, var(--line)); border-top: 0; border-radius: 0 0 16px 16px; position: relative; }
  .lf-back span { position: absolute; left: 50%; top: 100%; transform: translate(-50%, -50%); display: inline-flex; align-items: center; gap: 8px; padding: 4px 14px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); font-size: 0.85rem; font-weight: 600; color: var(--accent-text); white-space: nowrap; }
  .lf-back span :global(.pi) { width: 16px; height: 16px; fill: currentColor; }
  .lf-back-text { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .lf-steps li { animation: step-on 10s ease-in-out infinite; animation-delay: calc(var(--i) * 2s); }
  }
  @keyframes step-on {
    0%, 22%, 100% { border-color: var(--line); box-shadow: none; }
    4%, 18% { border-color: var(--accent); box-shadow: 0 6px 22px color-mix(in srgb, var(--accent) 22%, transparent); }
  }
  @media (max-width: 1000px) {
    .lf-steps { grid-template-columns: 1fr; gap: 26px; }
    .lf-steps li + li::before { top: -26px; left: 34px; width: 2px; height: 26px; }
    .lf-steps li + li::after { top: -12px; left: 30px; transform: rotate(135deg); }
    .lf-back { display: none; }
    .lf-back-text { display: block; margin-top: 18px; font-weight: 600; color: var(--accent-text); }
  }
</style>
