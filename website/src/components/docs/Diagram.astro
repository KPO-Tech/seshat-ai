---
// Diagramme d'architecture dessiné en SVG, aux couleurs du site (clair et sombre).
// Les noeuds et les liens sont décrits à la main (coordonnées du viewBox), ce qui donne une mise en page
// maîtrisée sans bibliothèque externe.
// Usage MDX : import { layers } from '@/components/docs/diagrams/runtime'; <Diagram {...layers} />
import Icon from '../Icon.astro';

type Kind = 'default' | 'entry' | 'core' | 'gate' | 'ok' | 'bad' | 'warn';
type Pt = [number, number];
interface Node {
  id: string; x: number; y: number; w: number; h: number;
  title: string; sub?: string[]; icon?: string; kind?: Kind;
  shape?: 'rect' | 'diamond'; layout?: 'row' | 'stack';
}
interface Edge {
  from: string | Pt; to: string | Pt; via?: Pt[];
  label?: string; at?: Pt; dashed?: boolean; both?: boolean; noArrow?: boolean; dot?: boolean; kind?: Kind;
}
interface Group { x: number; y: number; w: number; h: number; label: string }
interface Note { x: number; y: number; text: string; anchor?: 'start' | 'middle' }
interface Props {
  uid: string; width: number; height: number; label: string; caption?: string;
  nodes: Node[]; edges?: Edge[]; groups?: Group[]; notes?: Note[]; minWidth?: number;
}
const { uid, width, height, label, caption, nodes, edges = [], groups = [], notes = [], minWidth = 600 } = Astro.props;
const byId = new Map(nodes.map((n) => [n.id, n]));

// Point d'attache : « id:side » ou « id:side@décalage » (le décalage se mesure depuis le centre du côté).
function anchor(ref: string | Pt): Pt {
  if (Array.isArray(ref)) return ref;
  const [id, rest] = ref.split(':');
  const [side, off] = (rest ?? 'bottom').split('@');
  const n = byId.get(id)!;
  const d = Number(off ?? 0);
  const cx = n.x + n.w / 2;
  const cy = n.y + n.h / 2;
  if (side === 'top') return [cx + d, n.y];
  if (side === 'bottom') return [cx + d, n.y + n.h];
  if (side === 'left') return [n.x, cy + d];
  return [n.x + n.w, cy + d];
}

// Ligne brisée aux angles arrondis.
function rounded(pts: Pt[], r = 10): string {
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) {
    const prev = pts[i - 1];
    const cur = pts[i];
    const next = pts[i + 1];
    if (!next) { d += ` L${cur[0]} ${cur[1]}`; break; }
    const l1 = Math.hypot(cur[0] - prev[0], cur[1] - prev[1]);
    const l2 = Math.hypot(next[0] - cur[0], next[1] - cur[1]);
    const rr = Math.min(r, l1 / 2, l2 / 2);
    const a: Pt = [cur[0] - ((cur[0] - prev[0]) / l1) * rr, cur[1] - ((cur[1] - prev[1]) / l1) * rr];
    const b: Pt = [cur[0] + ((next[0] - cur[0]) / l2) * rr, cur[1] + ((next[1] - cur[1]) / l2) * rr];
    d += ` L${a[0].toFixed(1)} ${a[1].toFixed(1)} Q${cur[0]} ${cur[1]} ${b[0].toFixed(1)} ${b[1].toFixed(1)}`;
  }
  return d;
}

const paths = edges.map((e) => {
  const pts: Pt[] = [anchor(e.from), ...(e.via ?? []), anchor(e.to)];
  // Position de l'étiquette : milieu du premier segment, sauf indication contraire.
  const lx = e.at ? e.at[0] : (pts[0][0] + pts[1][0]) / 2;
  const ly = e.at ? e.at[1] : (pts[0][1] + pts[1][1]) / 2;
  return { e, d: rounded(pts), lx, ly, end: pts[pts.length - 1] };
});
const kinds: Kind[] = ['default', 'core', 'ok', 'bad', 'warn'];
---
<figure class="dg" role="group" aria-label={label}>
  <div class="dg-scroll" tabindex="0">
    <svg viewBox={`0 0 ${width} ${height}`} style={`min-width:${minWidth}px`} role="img" aria-label={label}>
      <defs>
        {kinds.map((k) => (
          <marker id={`${uid}-a-${k}`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M1 1 L9 5 L1 9 z" class={`dg-arrow dg-arrow-${k}`} />
          </marker>
        ))}
      </defs>

      {groups.map((g) => (
        <g class="dg-group">
          <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="16" />
          <text x={g.x + 16} y={g.y + 22}>{g.label}</text>
        </g>
      ))}

      {paths.map(({ e, d }) => (
        <path
          d={d}
          class={`dg-edge dg-edge-${e.kind ?? 'default'}${e.dashed ? ' dashed' : ''}`}
          fill="none"
          marker-end={e.noArrow ? undefined : `url(#${uid}-a-${e.kind ?? 'default'})`}
          marker-start={e.both ? `url(#${uid}-a-${e.kind ?? 'default'})` : undefined}
        />
      ))}
      {paths.filter((p) => p.e.dot).map((p) => <circle class="dg-dot" cx={p.end[0]} cy={p.end[1]} r="3.5" />)}

      {nodes.map((n) => {
        const kind = n.kind ?? 'default';
        const stack = n.layout === 'stack';
        const diamond = n.shape === 'diamond';
        const cx = n.x + n.w / 2;
        const cy = n.y + n.h / 2;
        const hasSub = (n.sub?.length ?? 0) > 0;
        const left = n.x + (n.icon && !stack && !diamond ? 46 : 16);
        const ty = hasSub ? n.y + 27 : cy + 5;
        return (
          <g class={`dg-node dg-${kind}`}>
            {diamond
              ? <polygon points={`${cx},${n.y} ${n.x + n.w},${cy} ${cx},${n.y + n.h} ${n.x},${cy}`} />
              : <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="12" />}
            {n.icon && !diamond && !stack && (
              <svg class="dg-ic" x={n.x + 14} y={cy - 11} width="22" height="22" viewBox="0 0 256 256"><Icon name={n.icon} /></svg>
            )}
            {n.icon && stack && (
              <svg class="dg-ic" x={cx - 11} y={n.y + 12} width="22" height="22" viewBox="0 0 256 256"><Icon name={n.icon} /></svg>
            )}
            {diamond
              ? <text class="dg-title" x={cx} y={cy + 5} text-anchor="middle">{n.title}</text>
              : stack
                ? (
                  <>
                    <text class="dg-title dg-stack" x={cx} y={n.y + 58} text-anchor="middle">{n.title}</text>
                    {(n.sub ?? []).map((s, i) => <text class="dg-sub dg-stack" x={cx} y={n.y + 77 + i * 15} text-anchor="middle">{s}</text>)}
                  </>
                )
                : (
                  <>
                    <text class="dg-title" x={left} y={ty}>{n.title}</text>
                    {(n.sub ?? []).map((s, i) => <text class="dg-sub" x={left} y={ty + 21 + i * 18}>{s}</text>)}
                  </>
                )}
          </g>
        );
      })}

      {paths.filter((p) => p.e.label).map((p) => <text class="dg-elabel" x={p.lx} y={p.ly - 6} text-anchor="middle">{p.e.label}</text>)}
      {notes.map((n) => <text class="dg-note" x={n.x} y={n.y} text-anchor={n.anchor ?? 'start'}>{n.text}</text>)}
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
