---
// Installation par système : trois onglets (Linux, macOS, Windows), chacun montrant un terminal avec les commandes
// dans l'ordre : installer, la dépendance ripgrep, vérifier, le modèle de titres local (facultatif), configurer,
// mettre à jour. Usage MDX : <OsInstall />
//
// Sans JavaScript, les trois terminaux restent affichés l'un sous l'autre. Avec, un seul est visible et l'onglet du
// système de la personne est choisi d'office.
type Line = { k: 'c' | 'cmd' | 'out'; t: string };
type Term = { id: string; label: string; shell: string; prompt: string; lines: Line[] };

const RAW = 'https://raw.githubusercontent.com/KPO-Tech/seshat-runtime/main/scripts';

const unix = (installNote: string, depNote: string, depCmd: string, depAlt: string): Line[] => [
  { k: 'c', t: `# 1. Install seshat ${installNote}` },
  { k: 'cmd', t: `curl -fsSL ${RAW}/install.sh | bash` },
  { k: 'out', t: '[seshat] Checksum OK' },
  { k: 'out', t: '✓ Seshat v1.10.0 installed successfully' },
  { k: 'c', t: '' },
  { k: 'c', t: `# 2. Dependency: ripgrep, used by the glob and grep tools ${depNote}` },
  { k: 'cmd', t: depCmd },
  { k: 'c', t: depAlt },
  { k: 'c', t: '' },
  { k: 'c', t: '# 3. Open a new terminal, then check' },
  { k: 'cmd', t: 'seshat version' },
  { k: 'out', t: 'v1.10.0' },
  { k: 'c', t: '' },
  { k: 'c', t: '# 4. Optional: name sessions on this machine (about 500 MB, CPU only, works offline)' },
  { k: 'cmd', t: 'seshat title-model install' },
  { k: 'out', t: 'It works: "Read CSV file in Go and sum one" in 1.7 s' },
  { k: 'c', t: '' },
  { k: 'c', t: '# 5. Choose a provider, then start' },
  { k: 'cmd', t: 'seshat config' },
  { k: 'cmd', t: 'seshat' },
  { k: 'c', t: '' },
  { k: 'c', t: '# Later: seshat also offers new releases at start-up, or update by hand' },
  { k: 'cmd', t: 'seshat update' },
];

const terms: Term[] = [
  {
    id: 'linux',
    label: 'Linux',
    shell: 'bash',
    prompt: '$',
    lines: unix(
      '(amd64 or arm64; adds ~/.local/bin to your PATH)',
      '(not installed by the script)',
      'sudo apt install ripgrep',
      '# Fedora: sudo dnf install ripgrep   ·   Arch: sudo pacman -S ripgrep   ·   Alpine: sudo apk add ripgrep',
    ),
  },
  {
    id: 'macos',
    label: 'macOS',
    shell: 'zsh',
    prompt: '%',
    lines: unix(
      '(Intel or Apple silicon; adds ~/.local/bin to your PATH)',
      '(not installed by the script)',
      'brew install ripgrep',
      '# With MacPorts: sudo port install ripgrep',
    ),
  },
  {
    id: 'windows',
    label: 'Windows',
    shell: 'PowerShell',
    prompt: 'PS>',
    lines: [
      { k: 'c', t: '# 1. Install seshat and ripgrep (amd64 or arm64; no administrator rights)' },
      { k: 'cmd', t: `irm ${RAW}/install.ps1 | iex` },
      { k: 'out', t: '[seshat] Checksum OK' },
      { k: 'out', t: '[seshat] ripgrep installed (winget, scoop or choco, whichever you have)' },
      { k: 'out', t: 'Seshat v1.10.0 installed successfully' },
      { k: 'c', t: '' },
      { k: 'c', t: '# 2. Dependencies: nothing to do, the script installed ripgrep. If none of winget, scoop or choco is there:' },
      { k: 'cmd', t: 'winget install BurntSushi.ripgrep.MSVC' },
      { k: 'c', t: '' },
      { k: 'c', t: '# 3. Open a new terminal (the PATH is read at start), then check' },
      { k: 'cmd', t: 'seshat version' },
      { k: 'out', t: 'v1.10.0' },
      { k: 'c', t: '' },
      { k: 'c', t: '# 4. Optional: name sessions on this machine (about 500 MB, CPU only, works offline)' },
      { k: 'cmd', t: 'seshat title-model install' },
      { k: 'out', t: 'It works: "Read CSV file in Go and sum one" in 1.7 s' },
      { k: 'c', t: '' },
      { k: 'c', t: '# 5. Choose a provider, then start (Windows Terminal or VS Code: shift+Enter for a new line)' },
      { k: 'cmd', t: 'seshat config' },
      { k: 'cmd', t: 'seshat terminal-setup' },
      { k: 'cmd', t: 'seshat' },
      { k: 'c', t: '' },
      { k: 'c', t: '# Later: seshat also offers new releases at start-up, or update by hand' },
      { k: 'cmd', t: 'seshat update' },
    ],
  },
];
---
<div class="os-install" data-os-install>
  <div class="os-tabs" role="tablist" aria-label="Operating system">
    {terms.map((term, i) => (
      <button type="button" class="os-tab" role="tab" id={`tab-${term.id}`} aria-controls={`panel-${term.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-os={term.id}>
        {term.label}
      </button>
    ))}
  </div>
  {terms.map((term, i) => (
    <section class="os-panel" role="tabpanel" id={`panel-${term.id}`} aria-labelledby={`tab-${term.id}`} data-os={term.id}>
      <div class="osx-term" data-term>
        <div class="osx-bar">
          <span class="osx-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="osx-title">{term.label} · {term.shell}</span>
          <button type="button" class="osx-copy" data-copy-all>Copy commands</button>
        </div>
        <pre class="osx-body"><code>{term.lines.map((line) => {
          if (line.k === 'cmd') return <span class="osx-ln osx-cmd"><span class="osx-pr" aria-hidden="true">{term.prompt} </span><span class="osx-tx" data-cmd>{line.t}</span>{'\n'}</span>;
          if (line.k === 'out') return <span class="osx-ln osx-out">{line.t}{'\n'}</span>;
          return <span class="osx-ln osx-c">{line.t}{'\n'}</span>;
        })}</code></pre>
      </div>
    </section>
  ))}
</div>

<style>
  .os-install { margin: 1.4em 0; }
  .os-tabs { display: none; gap: 6px; margin-bottom: -1px; position: relative; z-index: 1; }
  .os-install.is-ready .os-tabs { display: flex; }
  .os-tab {
    padding: 10px 20px; font: inherit; font-weight: 700; font-size: 0.95rem; cursor: pointer;
    border: 1px solid var(--line); border-bottom: 0; border-radius: 12px 12px 0 0;
    background: var(--band); color: var(--text2);
  }
  .os-tab:hover { color: var(--text); }
  .os-tab[aria-selected='true'] { background: var(--panel); color: var(--on-panel); border-color: var(--panel); }
  .os-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .os-panel { margin-top: 18px; }
  .os-install.is-ready .os-panel { margin-top: 0; }
  .os-install.is-ready .os-panel[data-hidden='true'] { display: none; }

  .osx-term { border-radius: 0 12px 12px 12px; overflow: hidden; background: var(--panel); color: var(--on-panel); box-shadow: var(--shadow); border: 1px solid color-mix(in srgb, var(--on-panel) 14%, transparent); }
  .os-install:not(.is-ready) .osx-term { border-radius: 12px; }
  .osx-bar { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: color-mix(in srgb, var(--on-panel) 8%, var(--panel)); border-bottom: 1px solid color-mix(in srgb, var(--on-panel) 12%, transparent); }
  .osx-dots { display: inline-flex; gap: 7px; }
  .osx-dots i { width: 11px; height: 11px; border-radius: 50%; background: color-mix(in srgb, var(--on-panel) 30%, transparent); }
  .osx-dots i:nth-child(1) { background: #e0675b; }
  .osx-dots i:nth-child(2) { background: #e2b04a; }
  .osx-dots i:nth-child(3) { background: #6fbf73; }
  .osx-title { flex: 1; font-size: 0.8rem; color: var(--on-panel2); font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; }
  .osx-copy { padding: 4px 11px; font: inherit; font-size: 0.78rem; font-weight: 600; cursor: pointer; border-radius: 8px; border: 1px solid color-mix(in srgb, var(--on-panel) 22%, transparent); background: transparent; color: var(--on-panel2); }
  .osx-copy:hover, .osx-copy:focus-visible { color: var(--orange-light); border-color: var(--orange-light); }

  .osx-body { margin: 0; padding: 18px 20px 20px; background: transparent !important; border: 0 !important; border-radius: 0 !important; overflow-x: auto; }
  .osx-body code { display: block; font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; font-size: 0.86rem; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; background: none; padding: 0; color: var(--on-panel); }
  .osx-ln.osx-c { color: color-mix(in srgb, var(--on-panel2) 85%, transparent); }
  .osx-ln.osx-out { color: color-mix(in srgb, var(--on-panel) 62%, transparent); }
  .osx-ln.osx-cmd .osx-pr { color: var(--orange-light); user-select: none; }
  .osx-ln.osx-cmd .osx-tx { color: var(--on-panel); cursor: copy; border-radius: 4px; }
  .osx-ln.osx-cmd .osx-tx:hover { background: color-mix(in srgb, var(--on-panel) 10%, transparent); }
  .osx-ln.osx-cmd .osx-tx.copied { background: color-mix(in srgb, var(--orange-light) 28%, transparent); }
</style>

<script>
  const detect = (): string => {
    const ua = navigator.userAgent;
    if (/Windows/i.test(ua)) return 'windows';
    if (/Mac/i.test(ua) && !/iPhone|iPad/i.test(ua)) return 'macos';
    return 'linux';
  };

  const copy = async (text: string): Promise<boolean> => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-os-install]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.os-tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.os-panel')];
    const select = (os: string, focus = false) => {
      for (const tab of tabs) {
        const on = tab.dataset.os === os;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      }
      for (const panel of panels) panel.dataset.hidden = panel.dataset.os === os ? 'false' : 'true';
    };
    root.classList.add('is-ready');
    select(detect());
    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab.dataset.os ?? 'linux'));
      tab.addEventListener('keydown', (event) => {
        const i = tabs.indexOf(tab);
        if (event.key === 'ArrowRight') select(tabs[(i + 1) % tabs.length].dataset.os ?? 'linux', true);
        if (event.key === 'ArrowLeft') select(tabs[(i + tabs.length - 1) % tabs.length].dataset.os ?? 'linux', true);
      });
    }

    for (const term of root.querySelectorAll<HTMLElement>('[data-term]')) {
      const flash = async (el: HTMLElement, label: string | null, text: string) => {
        if (!(await copy(text))) return;
        if (label !== null) {
          const old = el.textContent;
          el.textContent = label;
          setTimeout(() => { el.textContent = old; }, 1400);
        } else {
          el.classList.add('copied');
          setTimeout(() => el.classList.remove('copied'), 900);
        }
      };
      term.querySelector<HTMLElement>('[data-copy-all]')?.addEventListener('click', (event) => {
        const lines = [...term.querySelectorAll<HTMLElement>('[data-cmd]')].map((el) => el.textContent ?? '');
        void flash(event.currentTarget as HTMLElement, 'Copied', lines.join('\n'));
      });
      for (const cmd of term.querySelectorAll<HTMLElement>('[data-cmd]')) {
        cmd.title = 'Click to copy';
        cmd.addEventListener('click', () => void flash(cmd, null, cmd.textContent ?? ''));
      }
    }
  }
</script>
