---
// Schéma « un noyau qui possède plusieurs responsabilités » : un cœur au centre, ses responsabilités autour.
// Usage MDX : <Hub title="Seshat runtime" caption="..." items={[{ icon: 'chat-circle-text', name: 'Sessions', note: '...' }, ...]} />
import Icon from '../Icon.astro';
interface Item { icon: string; name: string; note?: string }
interface Props { title: string; caption?: string; items: Item[] }
const { title, caption, items } = Astro.props;
---
<figure class="dhub">
  <div class="dhub-core">
    <span class="dhub-hex"><img src="/brand/seshat.svg" alt="" width="56" height="56" /></span>
    <div>
      <strong>{title}</strong>
      {caption && <small>{caption}</small>}
    </div>
  </div>
  <ul class="dhub-items">
    {items.map((it, i) => (
      <li style={`--k:${i}`}>
        <span class="dhub-ic"><Icon name={it.icon} /></span>
        <span><strong>{it.name}</strong>{it.note && <small>{it.note}</small>}</span>
      </li>
    ))}
  </ul>
</figure>
