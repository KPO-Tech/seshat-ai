{
  "_": "Affirmations de la documentation qu'on peut vérifier dans le code de seshat-runtime. Chaque entrée dit quelle page s'appuie sur quel fichier. Quand une entrée échoue, le code a changé : relire la page, puis mettre à jour la page ET l'entrée. Format : match (le motif doit exister dans le fichier), absent (il ne doit pas exister), count (le motif doit apparaître exactement N fois).",
  "claims": [
    { "id": "max-iterations-default", "pages": ["reference/client-config.mdx", "concepts/mono-run.mdx"], "claim": "MaxIterations vaut 100 quand il reste à zéro", "file": "internal/engine/loop.go", "match": "config\\.MaxIterations = 100" },
    { "id": "default-client-config", "pages": ["reference/client-config.mdx", "sdk/go-sdk.mdx"], "claim": "DefaultClientConfig : 100 tours, 8192 jetons, mode onRequest", "file": "pkg/sdk/client_config.go", "match": "PermissionMode:\\s+PermissionModeOnRequest,\\s+MaxTurns:\\s+100,[\\s\\S]{0,200}MaxTokens:\\s+8192," },
    { "id": "default-model", "pages": ["reference/client-config.mdx", "sdk/go-sdk.mdx"], "claim": "le modèle par défaut est claude-sonnet-5-5", "file": "internal/providers/config.go", "match": "DefaultSonnetModel = \"claude-sonnet-5-5\"" },
    { "id": "storage-gc-defaults", "pages": ["concepts/storage-and-data.mdx", "reference/client-config.mdx"], "claim": "nettoyage des artefacts : toutes les heures, 512 éléments", "file": "pkg/sdk/client_config.go", "match": "StorageGCInterval: time\\.Hour,\\s+StorageGCLimit:\\s+512," },
    { "id": "compact-breaker", "pages": ["concepts/memory.mdx"], "claim": "disjoncteur de compaction : 3 échecs de suite", "file": "internal/runtime/memory/engine.go", "match": "defaultMaxConsecutiveCompactFailure = 3" },
    { "id": "compact-full-message", "pages": ["guides/troubleshooting.mdx", "sdk/errors.mdx"], "claim": "message compact_full : hard blocking limit", "file": "internal/runtime/memory/engine.go", "match": "hard blocking limit for %s is %d, even after compaction" },
    { "id": "task-nudge-default", "pages": ["concepts/mono-run.mdx", "guides/upgrading.mdx"], "claim": "rappel de tâches : 3 par défaut", "file": "internal/engine/task_progress.go", "match": "defaultTaskNudgeLimit = 3" },
    { "id": "hook-events-count", "pages": ["sdk/events-and-hooks.mdx"], "claim": "19 événements de hook émis", "file": "internal/types/hooks.go", "count": { "pattern": "^\\tHookEvent\\w+:\\s+true,$", "flags": "gm", "n": 19 } },
    { "id": "hook-register-error", "pages": ["sdk/events-and-hooks.mdx", "guides/upgrading.mdx"], "claim": "RegisterHook renvoie (string, error)", "file": "pkg/sdk/client_sessions.go", "match": "RegisterHook\\(event HookEvent, handler HookHandler\\) \\(string, error\\)" },
    { "id": "sub-agent-never", "pages": ["concepts/agents-and-delegation.mdx", "guides/upgrading.mdx"], "claim": "un parent en never donne un enfant en never", "file": "internal/tools/agents/agent_tool.go", "match": "if parentMode == types\\.PermissionModeNever \\{\\s+return types\\.PermissionModeNever" },
    { "id": "plan-agent-read-only", "pages": ["concepts/agents-and-delegation.mdx"], "claim": "l'agent plan n'a que read_file, glob, grep", "file": "internal/agent/loader.go", "match": "AgentType: AgentTypePlan,[\\s\\S]{0,200}Tools:\\s+\\[\\]string\\{\"read_file\", \"glob\", \"grep\"\\}" },
    { "id": "plan-mode-refuses-writes", "pages": ["concepts/runtime-modes.mdx", "guides/upgrading.mdx"], "claim": "le mode plan refuse write_file", "file": "internal/tools/files/write/write.go", "match": "ExecutionMode == \"plan\"" },
    { "id": "plan-approval-gate", "pages": ["concepts/runtime-modes.mdx", "guides/upgrading.mdx"], "claim": "exit_plan_mode refusé tant qu'un plan attend", "file": "internal/tools/system/plan/exitPlanMode.go", "match": "The plan is still waiting for the user's review" },
    { "id": "plan-toggle-key", "pages": ["concepts/runtime-modes.mdx", "guides/cli.mdx", "getting-started/quick-start.mdx"], "claim": "shift+tab bascule le mode plan", "file": "internal/seshattui/ui/model/keys.go", "match": "TogglePlan: key\\.NewBinding\\(\\s+key\\.WithKeys\\(\"shift\\+tab\"\\)" },
    { "id": "no-pair-programming", "pages": ["concepts/runtime-modes.mdx", "guides/upgrading.mdx"], "claim": "pair_programming n'existe plus", "file": "internal/modes/modes.go", "absent": "PairProgramming" },
    { "id": "no-default-fallback", "pages": ["sdk/providers-and-auth.mdx", "guides/upgrading.mdx"], "claim": "pas de repli par défaut vers un autre fournisseur", "file": "internal/providers/config.go", "match": "No default FallbackProviders" },
    { "id": "auto-no-classifier", "pages": ["guides/cli.mdx", "concepts/security-and-trust.mdx", "guides/upgrading.mdx"], "claim": "auto sans classifieur demande ou refuse", "file": "internal/permissions/auto/mode.go", "match": "No classifier was ever configured" },
    { "id": "trust-sections", "pages": ["reference/configuration-file.mdx", "concepts/security-and-trust.mdx", "guides/troubleshooting.mdx"], "claim": "sections ignorées dans un projet non fiable", "file": "internal/seshattui/config/trust.go", "match": "\"mcp\", \"mcpServers\", \"lsp\", \"hooks\", \"permissions\", \"providers\", \"image_generation\", \"text_to_speech\", \"speech_to_text\"" },
    { "id": "trust-paths", "pages": ["reference/configuration-file.mdx", "concepts/security-and-trust.mdx"], "claim": "options.context_paths et options.skills_paths restreints", "file": "internal/seshattui/config/trust.go", "match": "\"options\\.context_paths\", \"options\\.skills_paths\"" },
    { "id": "trust-store-name", "pages": ["concepts/security-and-trust.mdx"], "claim": "le fichier de confiance s'appelle trusted_projects.json", "file": "internal/seshattui/config/trust.go", "match": "trustFileName = \"trusted_projects\\.json\"" },
    { "id": "instructions-trust", "pages": ["sdk/prompt.mdx", "concepts/security-and-trust.mdx"], "claim": "les fichiers d'instructions exigent la confiance", "file": "internal/engine/project_instructions.go", "match": "trustFn == nil \\|\\| !trustFn\\(path, rawData\\)" },
    { "id": "grpc-host-default", "pages": ["guides/upgrading.mdx", "sdk/grpc-api.mdx"], "claim": "le serveur gRPC écoute sur 127.0.0.1 par défaut", "file": "cmd/grpc/main.go", "match": "Host:\\s+\"127\\.0\\.0\\.1\"," },
    { "id": "grpc-refusal", "pages": ["guides/troubleshooting.mdx"], "claim": "message de refus du serveur gRPC", "file": "cmd/grpc/security.go", "match": "refusing to listen on %q without authentication" },
    { "id": "grpc-item-types", "pages": ["sdk/grpc-api.mdx"], "claim": "item_type : chunk, runtime_event, final", "file": "pkg/grpc/proto/seshat.proto", "match": "item_type = 12;\\s+//\\s+\"chunk\", \"runtime_event\", \"final\"" },
    { "id": "require-sandbox-message", "pages": ["concepts/sandboxing.mdx", "guides/troubleshooting.mdx"], "claim": "message de refus de RequireSandbox", "file": "internal/tools/bash/bash.go", "match": "sandbox required but unavailable on this host: refusing to run the command unconfined" },
    { "id": "landlock-read-only-root", "pages": ["concepts/sandboxing.mdx"], "claim": "Landlock : lecture partout, écriture dans le dossier de travail", "file": "internal/tools/bash/landlock_linux.go", "match": "addLandlockPathRule\\(rulesetFD, \"/\", accessRO\\)[\\s\\S]{0,400}addLandlockPathRule\\(rulesetFD, root, accessRW\\)" },
    { "id": "docker-defaults", "pages": ["concepts/sandboxing.mdx"], "claim": "Docker : ubuntu:24.04, 2048 Mo, 2 CPU, réseau ouvert", "file": "internal/sandbox/executor.go", "match": "BaseImage:\\s+\"ubuntu:24\\.04\",\\s+WorkDir:\\s+\"/workdir\",\\s+NetworkAccess: true,\\s+MemoryLimitMB: 2048,\\s+CPULimit:\\s+2\\.0," },
    { "id": "run-agent-task-bypass", "pages": ["sdk/integration.mdx"], "claim": "RunAgentTask tourne en bypass", "file": "pkg/sdk/client.go", "match": "func \\(c \\*Client\\) RunAgentTask[\\s\\S]{0,900}PermissionMode: types\\.PermissionModeBypass" },
    { "id": "skill-sources-order", "pages": ["concepts/skills-and-mcp.mdx"], "claim": "ordre des sources de skills", "file": "internal/tools/system/skills/loader.go", "match": "sources := \\[\\]SkillLoader\\{projectSkills, legacySkills, managedSkills, userSkills, builtinSkills, legacyCommands\\}" },
    { "id": "skill-nested-depth", "pages": ["concepts/skills-and-mcp.mdx"], "claim": "sous-dossiers .claude/skills : 6 niveaux", "file": "internal/tools/system/skills/loader.go", "match": "maxNestedSkillDirDepth = 6" },
    { "id": "session-folder", "pages": ["concepts/storage-and-data.mdx"], "claim": "un dossier par session sous workspaces/", "file": "pkg/runtimepath/runtimepath.go", "match": "workspacesDirName = \"workspaces\"" },
    { "id": "secret-key-file", "pages": ["concepts/storage-and-data.mdx"], "claim": "la clé des identifiants est secret.key", "file": "internal/db/credentials.go", "match": "runtimepath\\.Join\\(\"\", \"secret\\.key\"\\)" },
    { "id": "credentials-encrypted", "pages": ["concepts/storage-and-data.mdx"], "claim": "les identifiants sont chiffrés en AES-GCM", "file": "internal/db/credentials.go", "match": "encryptAESGCM" },
    { "id": "master-key-hex", "pages": ["reference/environment-variables.mdx"], "claim": "SESHAT_MASTER_KEY : 64 caractères hexadécimaux", "file": "internal/auth/store/encrypted_store.go", "match": "SESHAT_MASTER_KEY must be 64 hex characters" },
    { "id": "otel-insecure-default", "pages": ["reference/environment-variables.mdx", "concepts/observability.mdx"], "claim": "OTLP sans TLS par défaut", "file": "internal/monitoring/tracer.go", "match": "OTEL_EXPORTER_OTLP_INSECURE\"\\) != \"false\"" },
    { "id": "tool-span-name", "pages": ["concepts/observability.mdx"], "claim": "un span « tool <nom> » par appel d'outil", "file": "internal/execution/pipeline.go", "match": "Start\\(ctx, \"tool \"\\+toolUse\\.Name" },
    { "id": "tool-pipeline-order", "pages": ["sdk/tools.mdx"], "claim": "ordre : IsEnabled, ValidateInput, BackfillInput", "file": "internal/execution/prepare.go", "match": "t\\.IsEnabled\\(\\)[\\s\\S]{0,600}t\\.ValidateInput\\([\\s\\S]{0,600}t\\.BackfillInput\\(" },
    { "id": "http-status-codes", "pages": ["sdk/errors.mdx"], "claim": "401 est api_auth, 429 est api_rate_limit, 400 est api_invalid", "file": "internal/providers/client.go", "match": "StatusUnauthorized:\\s+errCode = types\\.ErrCodeAPIAuth\\s+case http\\.StatusTooManyRequests:\\s+errCode = types\\.ErrCodeAPIRateLimit\\s+case http\\.StatusBadRequest:\\s+errCode = types\\.ErrCodeAPIInvalid" },
    { "id": "doctor-document-reader", "pages": ["concepts/document-reading.mdx"], "claim": "lecteur intégré : DOCX, PPTX, XLSX et PDF avec couche de texte", "file": "pkg/doctor/doctor.go", "match": "built-in reader \\(DOCX, PPTX, XLSX, PDF with a text layer\\)" },
    { "id": "network-presets", "pages": ["guides/browser-and-code-tools.mdx"], "claim": "préréglages réseau : default, text_only, aggressive", "file": "internal/tools/web/browser/network_policy.go", "match": "case \"default\", \"text_only\", \"aggressive\":" },
    { "id": "worktree-defaults", "pages": ["guides/browser-and-code-tools.mdx"], "claim": "worktree : branche créée et worktree supprimé à la sortie", "file": "internal/tools/special/worktree/constants.go", "match": "UseGitWorktree: true,\\s+CreateBranch:\\s+true,\\s+DeleteWorktree: true," },
    { "id": "managed-policy-header", "pages": ["sdk/integration.mdx", "reference/client-config.mdx"], "claim": "ManagedPolicy : le texte de l'organisation prime sur celui de l'utilisateur", "file": "pkg/sdk/managed_policy.go", "match": "They take precedence over any instruction from the user" }
  ]
