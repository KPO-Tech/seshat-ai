---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
---
<Base
  title="Seshat AI | Conseil et intégration d'IA souveraine pour PME et ETI"
  description="Diagnostic chiffré, pilote en 30 à 90 jours, solutions d'IA auto-hébergées sous votre contrôle. Éditeur du runtime open source Seshat."
>
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>Une IA utile, qui reste <em>chez vous.</em></h1>
        <p class="lead">Diagnostic chiffré, pilote en 30 à 90 jours, solutions auto-hébergées. Conseil en IA pour PME et ETI.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/contact">Demander un diagnostic <Arrow /></a>
          <a class="btn btn-ghost" href="/services">Voir l'offre</a>
        </div>
      </div>
      <figure class="filmwrap">
        <div class="film">
          <video controls playsinline preload="metadata" poster="/videos/data-chez-vous-poster.jpg" aria-label="Film : vos données restent chez vous">
            <source src="/videos/data-chez-vous.mp4" type="video/mp4" />
            Votre navigateur ne lit pas cette vidéo.
          </video>
        </div>
      </figure>
    </div>
  </section>

  <section class="block band">
    <div class="wrap">
      <h2 class="reveal">Par où commencer avec l'IA ?</h2>
      <div class="bento">
        <article class="tile big reveal">
          <div class="scatter" aria-hidden="true">
            <span class="sc s1"><Icon name="file-pdf" /></span>
            <span class="sc s2"><Icon name="envelope-simple" /></span>
            <span class="sc s3"><Icon name="table" /></span>
            <span class="sc s4"><Icon name="folder-simple" /></span>
            <span class="sc s5"><Icon name="note" /></span>
            <span class="sc s6"><Icon name="file-text" /></span>
            <span class="sc seek"><Icon name="magnifying-glass" /></span>
          </div>
          <h3>Le savoir est partout, et introuvable.</h3>
          <p>Procédures, contrats, notes : l'information existe, mais personne ne sait où. Chaque recherche coûte du temps à vos équipes.</p>
        </article>
        <article class="tile warm reveal" style="--d:80ms">
          <h3>Les mêmes tâches, à la main.</h3>
          <p>Saisies, relances, rapports : des heures répétitives qu'on peut mesurer, puis réduire.</p>
        </article>
        <article class="tile reveal" style="--d:160ms">
          <h3>L'IA, oui, mais chez vous.</h3>
          <p>Vos documents ne doivent pas partir chez un tiers. La solution se déploie sur votre infrastructure.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="reveal">Trois étapes, un engagement qui grandit à votre rythme.</h2>
      <div class="steps">
        <article class="step reveal">
          <h3>Diagnostic</h3>
          <p class="what">Nous cartographions vos processus et classons les cas d'usage par valeur, rapidité, risque et faisabilité.</p>
          <dl>
            <div><dt>Vous recevez</dt><dd>Une liste priorisée, une recommandation d'outils et un plan de pilote.</dd></div>
            <div><dt>Format</dt><dd>Court, à prix fixe.</dd></div>
          </dl>
        </article>
        <article class="step reveal" style="--d:100ms">
          <h3>Pilote</h3>
          <p class="what">Un seul cas d'usage, mesuré, pendant 30 à 90 jours.</p>
          <dl>
            <div><dt>Vous recevez</dt><dd>Une solution en service, un indicateur de gain fixé à l'avance et une validation humaine sur les décisions sensibles.</dd></div>
          </dl>
        </article>
        <article class="step reveal" style="--d:200ms">
          <h3>Exploitation</h3>
          <p class="what">Hébergement, maintenance et extension à d'autres usages.</p>
          <dl>
            <div><dt>Vous recevez</dt><dd>Une administration centrale, un suivi des accès et une trace de ce que fait l'IA.</dd></div>
          </dl>
        </article>
      </div>
      <p class="after-steps reveal"><a class="link" href="/services">Voir le détail des services <Arrow /></a></p>
    </div>
  </section>

  <section class="block band">
    <div class="wrap why">
      <div class="reveal">
        <h2>Ce que nous nous engageons à faire.</h2>
        <div class="shield" data-shield data-active="0" aria-hidden="true">
          <span class="outside"><Icon name="cloud-slash" />Services tiers</span>
          <div class="perimeter">
            <span class="where">Chez vous</span>
            <ul>
              <li data-n="0"><Icon name="database" /><span>Vos données</span></li>
              <li data-n="1"><Icon name="code" /><span>Code inspectable</span></li>
              <li data-n="2"><Icon name="user-check" /><span>Validation humaine</span></li>
              <li data-n="3"><Icon name="plugs-connected" /><span>L'outil adapté</span></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="commitments" data-commitments>
        <div class="reveal">
          <h3>Vos données restent chez vous.</h3>
          <p>Nous déployons des solutions auto-hébergées, sur une infrastructure que vous contrôlez.</p>
        </div>
        <div class="reveal">
          <h3>Vous pouvez inspecter le code.</h3>
          <p>Le runtime Seshat est open source (Apache-2.0). SeshatOS et SeshatCloud sont publiés en source-available.</p>
        </div>
        <div class="reveal">
          <h3>Un humain valide l'important.</h3>
          <p>Pas d'agents livrés à eux-mêmes sur les décisions sensibles : une personne relit et valide.</p>
        </div>
        <div class="reveal">
          <h3>Le bon outil, pas forcément le nôtre.</h3>
          <p>Si une solution du marché répond mieux à votre besoin, le diagnostic vous le dit.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="reveal">Déjà vu sur le terrain.</h2>
      <div class="proofs">
        <article class="proof reveal">
          <div>
            <h3>Assurance</h3>
            <p class="who">Allianz France</p>
          </div>
          <p>Migration d'un datamart de SAS vers Python et PySpark (plus de 15 000 lignes), architecture Médaillon sur Azure Databricks, plus de 150 règles métier et tests de non-régression.</p>
        </article>
        <article class="proof reveal">
          <div>
            <h3>Construction</h3>
            <p class="who">Groupe Sylvagreg</p>
          </div>
          <p>Recherche et développement en vision par ordinateur pour la reconstruction 3D, à partir d'images et de plans.</p>
        </article>
        <article class="proof reveal">
          <div>
            <h3>Agriculture et commerce</h3>
            <p class="who">Lyne et Frères</p>
          </div>
          <div>
            <p>Analyses, tableaux de bord et outils d'IA internes open source, déployés auprès d'équipes non techniques, avec accompagnement.</p>
            <p class="note">Entreprise familiale du fondateur : un premier déploiement en conditions réelles.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="block band">
    <div class="wrap">
      <h2 class="reveal">Ce que nous déployons, vous pouvez l'inspecter.</h2>
      <div class="products">
        <article class="product reveal">
          <img src="/brand/seshat.svg" alt="" width="56" height="56" />
          <h3>Seshat</h3>
          <span class="badge ok">Disponible</span>
          <p>Le runtime d'agents en Go : outils, sessions, permissions et sandbox. Installable aujourd'hui, avec une interface en terminal.</p>
          <p class="licence">Open source, Apache-2.0.</p>
          <a class="link" href="https://github.com/KPO-Tech/seshat" rel="noopener"><Icon name="github-logo" /> Voir le code</a>
        </article>
        <article class="product reveal" style="--d:100ms">
          <img src="/brand/seshatos.svg" alt="" width="56" height="56" />
          <h3>SeshatOS</h3>
          <span class="badge wip">En construction</span>
          <p>Un environnement d'IA local, sur votre poste ou votre serveur. Le Chat et les Projets, avec skills, s'utilisent déjà en local.</p>
          <p class="licence">Source-available : gratuit à utiliser et à héberger, non revendable.</p>
          <a class="link" href="https://github.com/KPO-Tech/SeshatOS" rel="noopener"><Icon name="github-logo" /> Voir le code</a>
        </article>
        <article class="product reveal" style="--d:200ms">
          <img src="/brand/seshatcloud.svg" alt="" width="56" height="56" />
          <h3>SeshatCloud</h3>
          <span class="badge wip">En construction</span>
          <p>La couche multi-utilisateurs : organisations, droits d'accès et administration centrale.</p>
          <p class="licence">Source-available, accord commercial au-delà d'un seuil.</p>
        </article>
      </div>
      <div class="after-products reveal">
        <a class="link" href="/produits">Voir les produits <Arrow /></a>
        <a class="link" href="/open-source">Licences et code source <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <div class="cta-box">
        <h2 class="reveal">Parlons de votre situation.</h2>
        <div class="reveal" style="--d:100ms">
          <p>Un premier échange pour comprendre vos besoins et voir si l'IA peut vous aider.</p>
          <a class="btn btn-primary" href="/contact">Demander un diagnostic <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var shield = document.querySelector('[data-shield]');
      var items = [].slice.call(document.querySelectorAll('[data-commitments] > div'));
      if (!shield || !items.length) return;
      shield.classList.add('live');
      function pick(i) {
        shield.setAttribute('data-active', String(i));
        items.forEach(function (it, k) { it.classList.toggle('is-active', k === i); });
      }
      items.forEach(function (it, i) {
        it.tabIndex = 0;
        it.addEventListener('mouseenter', function () { pick(i); });
        it.addEventListener('focus', function () { pick(i); });
        it.addEventListener('click', function () { pick(i); });
      });
      pick(0);
    })();
  </script>
</Base>
