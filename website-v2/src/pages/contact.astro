---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---
<Base
  current="/contact"
  title="Demander un diagnostic | Seshat AI"
  description="Décrivez votre situation en quelques lignes. Nous revenons vers vous pour fixer un premier échange."
>
  <header class="page-head">
    <div class="wrap">
      <h1>Parlons de votre situation.</h1>
      <p class="lead">Quelques lignes suffisent. Nous revenons vers vous pour fixer un premier échange.</p>
    </div>
  </header>

  <section class="block" style="padding-top:48px">
    <div class="wrap contact-grid">
      <form class="form reveal" method="post" action={endpoint} data-endpoint={endpoint} novalidate>
        <div class="field">
          <label for="nom">Nom</label>
          <input id="nom" name="nom" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Adresse e-mail</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="entreprise">Entreprise</label>
          <input id="entreprise" name="entreprise" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="taille">Taille de l'entreprise</label>
          <select id="taille" name="taille">
            <option value="">Je préfère ne pas préciser</option>
            <option>Moins de 20 personnes</option>
            <option>20 à 49 personnes</option>
            <option>50 à 250 personnes</option>
            <option>Plus de 250 personnes</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Que souhaitez-vous améliorer ?</label>
          <textarea id="message" name="message" rows="6" required></textarea>
          <p class="help">Un processus long, une information introuvable, une question sur la confidentialité : décrivez-le avec vos mots.</p>
        </div>
        <div class="field check">
          <input id="consent" name="consent" type="checkbox" required />
          <label for="consent">J'accepte que ces informations soient utilisées pour me répondre. <a href="/confidentialite">Politique de confidentialité</a></label>
        </div>
        <div class="field hp" aria-hidden="true">
          <label for="site">Ne pas remplir</label>
          <input id="site" name="site" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button class="btn btn-primary" type="submit">Envoyer ma demande <Arrow /></button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>

      <aside class="next reveal" style="--d:100ms">
        <h2>Ce qui se passe ensuite</h2>
        <ol>
          <li><strong>Nous lisons votre message.</strong></li>
          <li><strong>Nous vous proposons un échange.</strong> Pour comprendre votre situation et vos contraintes.</li>
          <li><strong>Nous vous disons franchement</strong> si un diagnostic a du sens pour vous, et sinon vers quoi vous tourner.</li>
        </ol>
        <p class="aside-note">Vos informations ne servent qu'à vous répondre.</p>
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.querySelector('.form');
      if (!form) return;
      var status = form.querySelector('.status');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        status.className = 'status';
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        if (form.site.value) return;
        var endpoint = form.dataset.endpoint;
        if (!endpoint) {
          status.classList.add('err');
          status.textContent = "L'envoi n'est pas encore disponible sur ce site. Merci de réessayer prochainement.";
          return;
        }
        status.textContent = 'Envoi en cours...';
        fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
          .then(function (r) {
            if (!r.ok) throw new Error('http ' + r.status);
            form.reset();
            status.classList.add('ok');
            status.textContent = 'Merci, votre message est bien parti. Nous revenons vers vous.';
          })
          .catch(function () {
            status.classList.add('err');
            status.textContent = "Le message n'a pas pu partir. Merci de réessayer dans un instant.";
          });
      });
    })();
  </script>
</Base>
