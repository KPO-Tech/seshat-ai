---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Check from '../components/Check.astro';
import Icon from '../components/Icon.astro';

const stages = [
  { name: 'Feuille de route', items: [] },
  { name: 'En construction', items: [{ n: 'SeshatOS', i: '/brand/seshatos.svg' }, { n: 'SeshatCloud', i: '/brand/seshatcloud.svg' }] },
  { name: 'Bêta', items: [] },
  { name: 'Disponible', items: [{ n: 'Seshat', i: '/brand/seshat.svg' }] },
];

const products = [
  {
    name: 'Seshat',
    logo: '/brand/seshat.svg',
    badge: 'Disponible',
    tone: 'ok',
    what: 'Le runtime d\'agents en Go. C\'est la fondation des deux autres briques, utilisable seul par des équipes techniques.',
    points: [
      'Outils, sessions, permissions et sandbox.',
      'Une quinzaine de fournisseurs de modèles, MCP, skills et RAG.',
      'Interface en terminal (seshat chat), ligne de commande, gRPC et SDK.',
    ],
    licence: 'Runtime open source, Apache-2.0. L\'interface terminal reprend du code de Crush (licence FSL-1.1-MIT).',
    status: 'Version 1.3, installable aujourd\'hui, avec son interface en terminal.',
    link: { href: 'https://github.com/KPO-Tech/seshat', label: 'Voir le code' },
    dark: false,
  },
  {
    name: 'SeshatOS',
    logo: '/brand/seshatos.svg',
    badge: 'En construction',
    tone: 'wip',
    what: 'Un environnement d\'IA local, auto-hébergé, sur votre poste ou votre serveur : un backend en Go et une application de bureau.',
    points: [
      'Le Chat et les Projets, avec skills et outils, s\'utilisent déjà en local.',
      'Recherche dans vos documents depuis le Chat. Vos documents restent sur votre machine.',
      'Écrans dédiés (connaissance, planification, administration) : ils arrivent ensuite.',
    ],
    licence: 'Source-available : gratuit à utiliser et à héberger, non revendable.',
    status: 'Public sur GitHub. Le Chat et les Projets sont utilisables, le reste est en construction.',
    link: { href: 'https://github.com/KPO-Tech/SeshatOS', label: 'Voir le code' },
    dark: true,
  },
  {
    name: 'SeshatCloud',
    logo: '/brand/seshatcloud.svg',
    badge: 'En construction',
    tone: 'wip',
    what: 'La couche multi-utilisateurs au-dessus du même runtime : celle qui sert quand l\'IA doit être partagée par toute une entreprise.',
    points: [
      'Organisations, droits d\'accès et provisionnement des comptes (SCIM).',
      'Console d\'administration et tâches planifiées.',
      'Lecture de documents et évaluation de la qualité de la recherche.',
    ],
    licence: 'Source-available. Accord commercial au-delà d\'un seuil. Licence en cours de finalisation.',
    status: 'Solide côté serveur, pas encore proposée seule.',
    private: true,
    dark: false,
  },
];

const shots = [
  { img: '/captures/tui-home.png', t: 'Accueil', d: 'Prêt en quelques secondes, avec les raccourcis essentiels sous les yeux.' },
  { img: '/captures/tui-working1.png', t: 'L\'agent au travail', d: 'La trace complète du raisonnement : réflexion, appels d\'outils, sous-agents et liste de tâches.' },
  { img: '/captures/tui-working2.png', t: 'Résultats en continu', d: 'Réponses diffusées au fil de l\'eau, en markdown, avec la durée de chaque outil.' },
  { img: '/captures/tui-model_selction.png', t: 'Choix du modèle', d: 'Changer de modèle parmi plus de vingt, en deux touches.' },
  { img: '/captures/tui-provider_config.png', t: 'Fournisseurs', d: 'Clés d\'API chiffrées, rangées par fournisseur.' },
  { img: '/captures/tui-commands_pannel.png', t: 'Réglages', d: 'Tous les raccourcis, à une touche de distance (ctrl+p).' },
];

const verbs = [
  { t: 'Poser une question', d: 'Obtenir une réponse sourcée sur vos documents, avec les droits d\'accès de chacun.', icon: 'chat-circle-text', tone: 'dark' },
  { t: 'Repérer les écarts', d: 'Retrouver les contenus périmés, contradictoires, en double ou manquants.', icon: 'magnifying-glass', tone: 'warm' },
  { t: 'Agir avec validation', d: 'Proposer une mise à jour, une tâche ou une réponse, soumise à validation humaine.', icon: 'user-check', tone: 'plain' },
];
---
<Base
  current="/produits"
  title="Produits | Seshat AI"
  description="Seshat, SeshatOS et SeshatCloud : ce qui est disponible, ce qui est en construction, et sous quelle licence."
>
  <header class="page-head contact-head">
    <div class="wrap">
      <h1>Ce que nous déployons, vous pouvez l'inspecter.</h1>
      <p class="lead">Trois briques, chacune avec son niveau de maturité réel. Nous ne présentons rien comme prêt s'il ne l'est pas.</p>
    </div>
  </header>

  <section class="block" style="padding-top:28px;padding-bottom:40px">
    <div class="wrap">
      <ol class="scale reveal" aria-label="Niveau de maturité des produits">
        {stages.map((s, i) => (
          <li class={s.items.length ? 'has' : ''} style={`--k:${i}`}>
            <span class="scale-name">{s.name}</span>
            <span class="scale-bar"></span>
            <span class="scale-items">
              {s.items.map((it) => <span class="scale-chip"><img src={it.i} alt="" width="22" height="22" />{it.n}</span>)}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block" style="padding-top:24px">
    <div class="wrap">
      <div class="prods">
        {products.map((p) => (
          <article class={`prod ${p.dark ? 'dark' : ''} reveal`}>
            <div class="prod-id">
              <img src={p.logo} alt="" width="64" height="64" />
              <h2>{p.name}</h2>
              <span class={`badge ${p.tone}`}>{p.badge}</span>
              <p class="prod-lic">{p.licence}</p>
              {p.link && <a class="link" href={p.link.href} rel="noopener"><Icon name="github-logo" /> {p.link.label} <Arrow /></a>}
              {p.private && <p class="prod-private"><Icon name="lock-key" /> Dépôt privé pour l'instant</p>}
            </div>
            <div>
              <p class="prod-what">{p.what}</p>
              <ul class="deliver">
                {p.points.map((x) => <li><Check />{x}</li>)}
              </ul>
              <p class="prod-status">{p.status}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block tui-block">
    <div class="wrap">
      <h2 class="reveal">Seshat dans votre terminal, installable aujourd'hui.</h2>
      <p class="intro reveal">Pas besoin d'attendre le reste : <code>seshat chat</code> ouvre une interface complète pour des sessions d'agent longues, avec vos propres clés de modèles, sur votre machine.</p>
      <div class="install reveal">
        <div class="cmd-bar">
          <span class="cmd-label">Installation</span>
          <button class="copy" type="button" data-copy="curl -fsSL https://raw.githubusercontent.com/KPO-Tech/seshat/main/scripts/install.sh | bash">Copier</button>
        </div>
        <pre class="cmd"><code>curl -fsSL https://raw.githubusercontent.com/KPO-Tech/seshat/main/scripts/install.sh | bash
seshat chat</code></pre>
      </div>
      <div class="gallery reveal" data-gallery>
        <figure class="shot">
          <div class="shot-frame"><img src={shots[0].img} alt={shots[0].t} width="1917" height="986" loading="lazy" data-main /></div>
          <figcaption data-cap><strong>{shots[0].t}</strong> <span>{shots[0].d}</span></figcaption>
        </figure>
        <div class="thumbs" role="tablist" aria-label="Captures de l'interface en terminal">
          {shots.map((s, i) => (
            <button class="thumb" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-img={s.img} data-t={s.t} data-d={s.d}>
              <img src={s.img} alt="" width="240" height="124" loading="lazy" />
              <span>{s.t}</span>
            </button>
          ))}
        </div>
      </div>
      <p class="fine reveal">Captures de l'interface actuelle. Elles montrent encore l'ancien nom du projet.</p>
      <a class="link reveal" href="https://github.com/KPO-Tech/seshat" rel="noopener"><Icon name="github-logo" /> Voir le code et la documentation <Arrow /></a>
    </div>
  </section>

  <section class="block band">
    <div class="wrap">
      <h2 class="reveal">Knowledge-to-Action : un type de pilote, pas un produit fini.</h2>
      <p class="intro reveal">Ce premier cas d'usage se construit avec vous, sur vos documents. L'interface Knowledge n'existe pas encore : la recherche sourcée s'utilise aujourd'hui depuis le Chat.</p>
      <div class="kta">
        {verbs.map((v, i) => (
          <article class={`pilot ${v.tone} reveal`} style={`--d:${i * 80}ms`}>
            <span class="chip big"><Icon name={v.icon} /></span>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <div class="cta-box">
        <h2 class="reveal">Voir ce qui convient chez vous.</h2>
        <div class="reveal" style="--d:100ms">
          <p>Le diagnostic dit quelle brique, quel outil du marché ou quel développement répond le mieux à votre besoin.</p>
          <a class="btn btn-primary" href="/contact">Demander un diagnostic <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var g = document.querySelector('[data-gallery]');
      if (g) {
        var main = g.querySelector('[data-main]');
        var cap = g.querySelector('[data-cap]');
        var thumbs = [].slice.call(g.querySelectorAll('.thumb'));
        var pick = function (i, focus) {
          var b = thumbs[i];
          thumbs.forEach(function (x, k) { x.setAttribute('aria-selected', k === i ? 'true' : 'false'); x.tabIndex = k === i ? 0 : -1; });
          main.src = b.getAttribute('data-img');
          main.alt = b.getAttribute('data-t');
          cap.querySelector('strong').textContent = b.getAttribute('data-t');
          cap.querySelector('span').textContent = b.getAttribute('data-d');
          if (focus) b.focus();
        };
        thumbs.forEach(function (b, i) {
          b.addEventListener('click', function () { pick(i); });
          b.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowRight') { e.preventDefault(); pick(Math.min(i + 1, thumbs.length - 1), true); }
            if (e.key === 'ArrowLeft') { e.preventDefault(); pick(Math.max(i - 1, 0), true); }
          });
        });
      }
      var cp = document.querySelector('.copy');
      if (cp) cp.addEventListener('click', function () {
        var text = cp.getAttribute('data-copy');
        var done = function () { var old = cp.textContent; cp.textContent = 'Copié'; setTimeout(function () { cp.textContent = old; }, 1600); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, function () {});
      });
    })();
  </script>
</Base>
